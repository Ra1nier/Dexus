@page "/vault"
@using MudBlazor
@using System.Text.Json
@using Models
@using GuardianVaultManager.Client.Pages

<MudGrid>
    <MudItem xs="12" md="9">
        <MudGrid Class="vault-grid" Spacing="2">
            @foreach (var item in Items)
            {
                <MudItem xs="6" sm="4" md="2">
                    <MudPaper Class="vault-item" Elevation="5" @onclick="() => SelectItem(item)">
                        <img src="Resources/Null.webp" alt="Weapon" class="vault-image" />
                        <div class="vault-text">
                            @item.ItemHash
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudItem>

    <MudItem xs="12" md="3">
        @if (SelectedItem != null)
        {
            <MudPaper Elevation="5" Class="info-panel">
                <h4>Item Details</h4>
                <p><strong>Item Hash:</strong> @SelectedItem.ItemHash</p>
                <p><strong>Item Instance ID:</strong> @SelectedItem.ItemInstanceId</p>
                <p><strong>Quantity:</strong> @SelectedItem.Quantity</p>
                <p><strong>Location:</strong> @SelectedItem.Location</p>
                <p><strong>Lockable:</strong> @(SelectedItem.Lockable ? "Yes" : "No")</p>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private List<Item> Items = new List<Item>();
    private Item SelectedItem;

    protected override async void OnInitialized()
    {
        string contents = await GVM.core.GetVaultContents();
        JsonDocument vaultContents = JsonDocument.Parse(contents);
        JsonElement itemsArray = vaultContents.RootElement.GetProperty("Response").GetProperty("profileInventory").GetProperty("data").GetProperty("items");

        // Iterate over the items and populate the list
        Items = new List<Item>();
        foreach (JsonElement itemElement in itemsArray.EnumerateArray())
        {
            Item item = JsonSerializer.Deserialize<Item>(itemElement) ?? new Item();
            Items.Add(item);
        }
    }

    private void SelectItem(Item item)
    {
        SelectedItem = item;
    }
}