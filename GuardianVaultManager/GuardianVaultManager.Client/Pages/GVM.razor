@page "/GVM"
@rendermode InteractiveServer

@using GuardianVaultManagerCore
@using System.Diagnostics
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager Navigation

<PageTitle>Guardian Vault Manager</PageTitle>

<h1>GVM</h1>

@if (!core.OAuthStatus)
{
    <body class="bg-dark">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card shadow-lg">
                        <div class="card-body text-center">
                            <h1 class="card-title mb-4">Guardian Vault Manager</h1>
                            <p class="card-text mb-4">Welcome to Guardian Vault Manager. Looks like we can't spy on your vault. Would you mind signing in so that we can harvest your data?</p>
                            <button class="btn btn-primary" @onclick="HandleSignIn">Sign In</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
}
else
{
    <!--
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-lg">
                    <div class="card-body text-center">
                        <h1 class="card-title mb-4">Guardian Vault Manager</h1>
                        <p class="card-text mb-4">Welcome to Guardian Vault Manager. We found you and now know everything!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>-->

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Vault Manager</title>
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="d-flex flex-column h-100">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <a class="navbar-brand" href="#">Vault Manager</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="#">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Items</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Vault</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Settings</a>
                    </li>
                </ul>
            </div>
        </nav>
        <div class="center-console flex-fill">
            <div class="container text-center">
                <p>Your items will be displayed here.</p>
            </div>
        </div>
        <div class="bg-dark text-white p-3">
            <div class="container">
                <input type="text" class="form-control" placeholder="Enter your message...">
            </div>
        </div>
    </body>
    </html>
}


@code
{
    /// <summary>
    /// Core of GuardianVaultManger.
    /// </summary>
    public static Core core = new Core();

    protected override void OnInitialized()
    {
        // Start GuardianVaultManager Core
        try
        {
            Console.WriteLine("OnInitialized started.");
            core.StartCoreService();
            Console.WriteLine("OnInitialized completed successfully.");
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error in OnInitialized: {e.Message}");
            throw;
        }
    }

    /// <summary>
    /// Calls the core service to handle bungie OAuth Sign in
    /// </summary>
    private void HandleSignIn()
    {
        Debug.WriteLine("Sign In Started");

        // Redirect to Bungie sign-in for GuardianVaultManager
        if (!core.OAuthStatus)
        {
            Navigation.NavigateTo(core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }
}