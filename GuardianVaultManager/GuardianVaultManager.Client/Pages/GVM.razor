@page "/GVM"
@rendermode InteractiveServer

@using GuardianVaultManagerCore
@using RequestManager
@using ContentManager
@using ContentManager.Models
@using System.Diagnostics
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using MudBlazor
@using GuardianVaultManager.Client.Componates

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ILogger<GVM> Logger
@inject ISnackbar Snackbar

<!--<NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="OnApplicationExit" />-->

<PageTitle>Guardian Vault Manager</PageTitle>

@if (core.OAuthStatus == 2)
{
    <!--Sign In Page-->
    <MudContainer Class="justify-center d-flex flex-column align-items-center justify-content-center min-vh-100 bg-dark">
        <MudCard Class="text-center" Elevation="10" Style="max-width: 400px;">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom>Guardian Vault Manager</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    Welcome to Guardian Vault Manager. Looks like we can't spy on your vault. Would you mind signing in so that we can harvest your data?
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="HandleSignIn">Sign In to Bungie.com</MudButton>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
else
{
    <!--Main Content-->
    @if (initializationComplete)
    {
        <!--Main Vault Manager-->
        <MudContainer Fixed="true" MaxWidth="MaxWidth.ExtraLarge" Class="d-flex flex-column gap-3">
            <!--Guardian Manager Settings-->
            <MudPaper Style="overflow:hidden; position:relative;">
                <MudExpansionPanel Text="Manager Settings" MaxHeight="150">
                    <MudTabs Outlined="true" MinimumTabWidth="20px">
                        <MudTabPanel Icon="@Icons.Material.Filled.Settings">
                            @{string name = "Weapon-Names";}
                            <MudSwitch T=bool Value="GetSettingValue(name)" ValueChanged="(bool newValue) => SetSettingValue(name, newValue)" Label="Success" Color="Color.Success" />
                        </MudTabPanel>
                    </MudTabs>
                </MudExpansionPanel>
            </MudPaper>

            <!-- Column Labels -->
            <MudGrid Class="d-flex justify-center" Justify="Justify.SpaceBetween">
                @foreach (var character in content.Characters.Values)
                {
                    <MudItem xs="6" sm="3" md="2" lg="2" Class="d-flex flex-column justify-center">
                        <MudText Typo="Typo.h6" Class="mb-1 text-center">@character.Class</MudText>
                        <MudImage ObjectFit=@ObjectFit.ScaleDown Src=@character.EmblemBackgroundPath Elevation="25" Class="rounded-lg" />
                    </MudItem>
                }
                <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column justify-center">
                    <MudText Typo="Typo.h6" Class="mb-1 text-center">Vault</MudText>
                    <MudImage ObjectFit=@ObjectFit.ScaleDown Height="55" Src="Resources/VaultEmblem.png" Elevation="25" Class="rounded-lg" />
                </MudItem>
            </MudGrid>

            <!-- Postmaster Section -->
            <MudPaper Class="d-flex flex-column gap-2">
                <MudGrid Class="d-flex" Justify="Justify.SpaceBetween">
                    @foreach (var character in content.Characters.Values)
                    {
                        <MudItem xs="6" sm="3" md="2" lg="2" Class="d-flex flex-column">
                            <MudDropZone T="Item" Identifier=@character.CharacterId Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1" Style="height: 100%; width: 100%;">
                                @foreach (var item in content.Postmaster.Where(i => i.Value.Identifier == character.CharacterId))
                                {
                                    <MudCard Style="width: 60px; height: 60px; display: flex; flex-direction: column; justify-content: space-between; align-items: center;" Elevation="4">
                                        <MudCardMedia Image=@content.Details[item.Value.ItemHash].DisplayProperties.Icon alt="Weapon" Style="width: 100%; height: 100%; object-fit: cover;" />
                                        <MudCardContent Style="text-align: center; padding: 4px;">
                                            <MudText Typo="Typo.body2" Style="font-size: 10px;">@content.Details[item.Value.ItemHash].DisplayProperties.Name</MudText>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudDropZone>
                        </MudItem>
                    }

                    <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column">
                        <MudDropZone T="Item" Identifier="Vault" Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1" Style="min-width: 50%; height: 100%;">
                        </MudDropZone>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Kinetic Weapons Section-->
            <ManagmentList Items="content.KineticWeapons.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings/>

            <!-- Energy Weapons Section -->
            <ManagmentList Items="content.EnergyWeapons.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Power Weapons Section -->
            <ManagmentList Items="content.PowerWeapons.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Helmets Section -->
            <ManagmentList Items="content.Helmets.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Gauntlets Section -->
            <ManagmentList Items="content.Gauntlets.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Chests Section -->
            <ManagmentList Items="content.Chests.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Legs Section -->
            <ManagmentList Items="content.Legs.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Class Items Section -->
            <ManagmentList Items="content.Skirts.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Accessories Section -->
            <ManagmentList Items="content.Accessories.Values" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />

            <!-- Consumables Section -->
            <ManagmentList Items="content.Consumables" Characters="content.Characters.Values" Details="content.Details" Core=@core Content=@content Settings=@core.Settings />
        </MudContainer>
    }
    else
    {
        <!--Vault loading Page-->
        <MudContainer Fixed="true" MaxWidth="MaxWidth.ExtraLarge" Class="d-flex flex-column gap-3 justify-center">
            <div class="loader"></div>
            <MudProgressLinear Color="Color.Error" Buffer="true" Value="@core.Loadingbars.GetProgressValue("Main")" BufferValue="@core.Loadingbars.GetBufferValue("Main")" Class="my-7">
                @if (!string.IsNullOrEmpty(core.Loadingbars.GetProgressText("Main")))
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Dark">
                        <b>@core.Loadingbars.GetProgressText("Main")</b>
                    </MudText>
                }
            </MudProgressLinear>
        </MudContainer>
    }
}

@code {
    // GVM Objects
    public static Core core = new Core();
    public static ContentManager content = new ContentManager();
    private bool initializationComplete = false;

    /// <summary>
    /// Handles the first render of the webpage. 
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected async override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (core.OAuthStatus != 0 && core.OAuthStatus == 1)
            {
                if (!await core.ConfirmOAuthStatus())
                    return;
            }

            await core.InitializeClientContent();
            InitializeSettings();

            initializationComplete = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// When page loads or reloads fetch load all important information.
    /// </summary>
    protected async override void OnInitialized()
    {
        core = Core.Instance;
        content = core.Content;

        await core.ConfirmOAuthStatus();
        SnackbarProvider();
    }

    /// <summary>
    /// Initializes the startup settings for the application.
    /// </summary>
    private void InitializeSettings()
    {
        core.Settings.SetSettings(new Dictionary<string, bool>
        {
            { "Weapon-Names", false },
        }, false);
    }

    /// <summary>
    /// Starts the snackbar provider to display messages to the user.
    /// </summary>
    private void SnackbarProvider()
    {
        new Thread(async () =>
        {
            while (true)
            {
                await Task.Delay(1000);
                while (core.Snackbar.NextMessage(out string message, out string severity))
                {
                    Severity mode = (Severity)Enum.Parse(typeof(Severity), severity);
                    Snackbar.Add(message, mode);
                }
            }
        }).Start();
    }

    /// <summary>
    /// Returns the value of the setting.
    /// </summary>
    /// <param name="setting">Setting to get value of.</param>
    /// <returns>The Value of the setting.</returns>
    private bool GetSettingValue(string setting)
    {
        return core.Settings.Check(setting);
    }

    /// <summary>
    /// Returns the value of the setting.
    /// </summary>
    /// <param name="setting">Setting to get value of.</param>
    /// <param name="newValue">Value to set setting to.</param>
    /// <returns>The Value of the setting.</returns>
    private void SetSettingValue(string setting, bool newValue)
    {
        core.Settings.SetSetting(setting, newValue, true);
        StateHasChanged();
    }

    private void RefreshManagmentLists()
    {

    }

    /// <summary>
    /// Starts the Sign In process at Bungie.
    /// </summary>
    private void HandleSignIn()
    {
        Logger.LogDebug("Sign In Started");

        if (core.OAuthStatus > 0)
        {
            Navigation.NavigateTo(core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }

    /// <summary>
    /// Handles final actions before the page is closed.
    /// </summary>
    // [JSInvokable]
    // private void OnApplicationExit()
    // {
    //     core.Settings.SaveSettings();
    //     Logger.LogError("Application Closed. Settings Saved");
    // }
}