@page "/GVM"
@rendermode InteractiveServer

@using GuardianVaultManager.Client.Models
@using GuardianVaultManagerCore
@using System.Diagnostics
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using MudBlazor

@inject NavigationManager Navigation
@inject ILogger<GVM> Logger;

<PageTitle>Guardian Vault Manager</PageTitle>

@if (!core.OAuthStatus)
{
    <MudContainer Class="justify-center d-flex flex-column align-items-center justify-content-center min-vh-100 bg-dark">
        <MudCard Class="text-center" Elevation="10" Style="max-width: 400px;">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom>Guardian Vault Manager</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    Welcome to Guardian Vault Manager. Looks like we can't spy on your vault. Would you mind signing in so that we can harvest your data?
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="HandleSignIn">Sign In to Bungie.com</MudButton>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
else
{
    <MudContainer Fixed="true">
        <!-- Vault Grid -->
        <MudGrid GutterSize="GutterSize.Small">
            <!-- Vault Items -->
            <MudItem xs="12" sm="4" md="4">
                @if (Items.Any())
                {
                    <MudGrid Spacing="3" Class="d-flex flex-wrap">
                        @foreach (var item in Items)
                        {
                            <MudItem xs="12" sm="4" md="3">
                                <MudCard>
                                    <MudCardMedia Image="Resources/Null.png" Height="100" />
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6">@item.ItemHash</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudText Typo="Typo.body1">No items found in the vault.</MudText>
                }
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {
    public static Core core = new Core();
    private List<Item> Items = new List<Item>();
    private Item SelectedItem;

    protected override async void OnInitialized()
    {
        try
        {
            core.StartCoreService();
            Logger.LogDebug("Core started.");

            // Fetch vault contents
            string contents = await GVM.core.GetVaultContents();
            JsonDocument vaultContents = JsonDocument.Parse(contents);
            JsonElement itemsArray = vaultContents.RootElement.GetProperty("Response").GetProperty("profileInventory").GetProperty("data").GetProperty("items");

            // Populate Items list
            Items = new List<Item>();
            foreach (JsonElement itemElement in itemsArray.EnumerateArray())
            {
                Item item = JsonSerializer.Deserialize<Item>(itemElement) ?? new Item();
                Items.Add(item);
            }

            Logger.LogInformation($"Loaded {Items.Count} items into vault.");
        }
        catch (Exception e)
        {
            Logger.LogCritical($"Error in OnInitialized: {e.Message}");
        }

        StateHasChanged();
    }

    private void SelectItem(Item item)
    {
        SelectedItem = item;
    }

    private void HandleSignIn()
    {
        Logger.LogDebug("Sign In Started");

        if (!core.OAuthStatus)
        {
            Navigation.NavigateTo(core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }
}
