@page "/GVM"
@rendermode InteractiveServer

@using GuardianVaultManager.Client.Models
@using GuardianVaultManager.Client.Models.Characters
@using GuardianVaultManagerCore
@using System.Diagnostics
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using MudBlazor

@inject NavigationManager Navigation
@inject ILogger<GVM> Logger;

<PageTitle>Guardian Vault Manager</PageTitle>

@if (!core.OAuthStatus)
{
    <MudContainer Class="justify-center d-flex flex-column align-items-center justify-content-center min-vh-100 bg-dark">
        <MudCard Class="text-center" Elevation="10" Style="max-width: 400px;">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom>Guardian Vault Manager</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    Welcome to Guardian Vault Manager. Looks like we can't spy on your vault. Would you mind signing in so that we can harvest your data?
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="HandleSignIn">Sign In to Bungie.com</MudButton>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
else
{
    <MudContainer Fixed="true" MaxWidth="MaxWidth.ExtraLarge" Class="d-flex flex-row gap-3">
        <!-- Vault Items -->
        @if (Vault.Any())
        {
            <MudDropContainer T="Item" Items="Vault" ItemsSelector="@((item,dropzone) => item.Identifier == dropzone)" ItemDropped="Transfer" Class="d-flex flex-wrap flex-grow-1">
                <ChildContent>
                    <MudContainer Fixed="true" MaxWidth="MaxWidth.ExtraLarge">
                        <MudGrid>
                            <MudItem xs="6" Class="d-flex">
                                <!-- Guardian Zones -->
                                <MudDropZone T="Item" Identifier="Dummy Drop" Class="rounded mud-background-gray pa-6 ma-8 d-flex flex-wrap gap-2">
                                    <MudText Typo="Typo.h6" Class="mb-4 w-100">Dummy Drop</MudText>
                                </MudDropZone>
                            </MudItem>
                            <MudItem xs="6" Class="d-flex">
                                <!-- Vault Drop Zone -->
                                <MudDropZone T="Item" Identifier="Vault" Class="rounded mud-background-gray pa-6 ma-8 d-flex flex-wrap gap-2">
                                    <MudText Typo="Typo.h6" Class="mb-4 w-100">Vault</MudText>
                                </MudDropZone>
                            </MudItem>
                        </MudGrid>
                    </MudContainer>
                </ChildContent>
                <ItemRenderer>
                    <MudCard Style="width: 75px; height: 100px; display: flex; flex-direction: column; justify-content: space-between;" Elevation="4">
                        <!-- Image Section -->
                        <MudCardMedia Image="Resources/Null.png" Alt="Weapon" Style="flex: 8; height: 80%; width: 100%; object-fit: contain;" />
                        <MudCardContent Style="flex: 2; text-align: center; padding: 4px;">
                            <MudText Typo="Typo.body2">@context.ItemHash</MudText>
                        </MudCardContent>
                    </MudCard>
                </ItemRenderer>
            </MudDropContainer>
        }
        else
        {
            <MudText Typo="Typo.body1">No items found in the vault.</MudText>
        }
    </MudContainer>
}

@code {
    // GVM Objects
    public static Core core = new Core();

    // Client specific objects
    private List<Character> Characters = new List<Character>();
    private List<Item> Vault = new List<Item>();
    private List<Item> Inventories = new List<Item>();

    protected override void OnInitialized()
    {
        core.StartCoreService();
        Logger.LogDebug("Core started.");

        // Fetch Characters
        FetchClientCharacters();

        // Load Vault
        LoadClientVault();

        StateHasChanged();
    }

    /// <summary>
    /// Starts the Sign In process at Bungie
    /// </summary>
    private void HandleSignIn()
    {
        Logger.LogDebug("Sign In Started");

        if (!core.OAuthStatus)
        {
            Navigation.NavigateTo(core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }

    /// <summary>
    /// Handles transfers of items from one bucket to another.
    /// </summary>
    /// <param name="item">Item being transferred</param>
    private void Transfer(MudItemDropInfo<Item> item)
    {
        if (item.Item != null)
        {
            item.Item.Identifier = item.DropzoneIdentifier;
        }
    }

    /// <summary>
    /// Gets clients character information from bungie.
    /// </summary>
    private async void FetchClientCharacters()
    {
        try
        {
            string charactersJson = await core.GetCharacters();
            JsonDocument charactersContent = JsonDocument.Parse(charactersJson);
            JsonElement characters = charactersContent.RootElement.GetProperty("Response").GetProperty("characters").GetProperty("data");

            foreach (JsonProperty characterJson in characters.EnumerateObject())
            {
                if (characterJson.Value.ValueKind != JsonValueKind.Null)
                {
                    var characterDetails = characterJson.Value;

                    // Deserialize character details
                    var character = JsonSerializer.Deserialize<Character>(characterDetails);

                    if (character != null)
                    {
                        // Assign the character ID manually
                        character.CharacterId = characterJson.Name;
                        Characters.Add(character);
                    }
                }
                else
                {
                    Logger.LogWarning($"Character details for ID {characterJson.Name} are null.");
                }
            }
        }
        catch (Exception e)
        {
            Logger.LogError($"GVM was unable to retrieve the client's characters: {e.Message}");
        }
    }

    /// <summary>
    /// Creates the clients character inventory contents from bungie.
    /// </summary>
    private async void LoadClientInventories()
    {
        try
        {
            // Fetch Inventories contents
            string inventoriesContentsJson = await core.GetCharactersInventories();
            JsonDocument inventoriesContents = JsonDocument.Parse(inventoriesContentsJson);
            JsonElement charactersArray = inventoriesContents.RootElement.GetProperty("Response").GetProperty("characterInventories").GetProperty("data");

            // Populate Inventories list
            Inventories = new List<Item>();
            // TODO: add logic for inventories

            Logger.LogInformation($"Loaded {Inventories.Count} items into Inventories.");
        }
        catch (Exception e)
        {
            Logger.LogError($"GVM was unable to retrieve the client's inventories: {e.Message}");
        }
    }

    /// <summary>
    /// Creates the clients vault contents from bungie.
    /// </summary>
    private async void LoadClientVault()
    {
        try
        {
            // Fetch vault contents
            string vaultContentsJson = await core.GetVaultContents();
            JsonDocument vaultContents = JsonDocument.Parse(vaultContentsJson);
            JsonElement vaultArray = vaultContents.RootElement.GetProperty("Response").GetProperty("profileInventory").GetProperty("data").GetProperty("items");

            // Populate Vault list
            Vault = new List<Item>();
            foreach (JsonElement itemElement in vaultArray.EnumerateArray())
            {
                Item item = JsonSerializer.Deserialize<Item>(itemElement) ?? new Item();
                item.Identifier = "Vault";
                Vault.Add(item);
            }

            Logger.LogInformation($"Loaded {Vault.Count} items into Vault.");
        }
        catch (Exception e)
        {
            Logger.LogError($"GVM was unable to retrieve the client's vault: {e.Message}");
        }
    }
}
