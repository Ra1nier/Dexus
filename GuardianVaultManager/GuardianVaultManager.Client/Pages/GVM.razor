@code {
    // GVM Objects
    public static Core core = new Core();
    public static ContentManager content = new ContentManager();
    private bool initializationComplete = false;

    /// <summary>
    ///   First render start the core.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected async override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (core.OAuthStatus)
            {
                await content.InitializeClientContent();

                // Set initialization complete
                initializationComplete = true;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// When page loads or reloads fetch load all important information.
    /// </summary>
    protected override void OnInitialized()
    {
        core = Core.Instance;
        content = core.Content;
    }

    /// <summary>
    /// Displays a snackbar message to the user.
    /// </summary>
    /// <param name="message">Message to send. Should not be long.</param>
    public void DisplaySnackbar(string message)
    {
        Snackbar.Add(message, Severity.Info);
    }

    /// <summary>
    /// Displays a snackbar message to the user. Will display message as the severity specified.
    /// </summary>
    /// <param name="message">Message to send. Should not be long.</param>
    /// <param name="mode">Severity to use.</param>
    public void DisplaySnackbar(string message, Severity mode)
    {
        Snackbar.Add(message, mode);
    }

    /// <summary>
    /// Starts the Sign In process at Bungie.
    /// </summary>
    private void HandleSignIn()
    {
        Logger.LogDebug("Sign In Started");

        if (!core.OAuthStatus)
        {
            Navigation.NavigateTo(core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }

    /// <summary>
    /// Handles transfers of items between buckets and informs the core of the change.
    /// Supports Vault to Character, Character to Vault, and Character to Character transfers.
    /// </summary>
    /// <param name="item">Item being transferred.</param>
    private async void Transfer(MudItemDropInfo<Item> item)
    {
        if (item.Item != null)
        {
            var transfer = item.Item;

            // Item bucket Identification
            string origin = transfer.Identifier ?? string.Empty;
            string destination = item.DropzoneIdentifier;

            // Item Transfer Identification
            uint itemHash = transfer.ItemHash;
            string itemID = transfer.ItemInstanceId ?? "-1";
            int stackSize = transfer.Quantity;

            // Determine the origin and destination of the transfer
            bool transferSuccess = false;
            if (destination == "Vault") // Character -> Vault
            {
                // Transfer to Vault
                transferSuccess = await core.TransferItem(itemHash, itemID, stackSize, origin, true);
            }
            else if (origin == "Vault") // Vault -> Character
            {
                // Transfer to Character
                transferSuccess = await core.TransferItem(itemHash, itemID, stackSize, destination, false);
            }
            else // Character -> Character
            {
                // Transfer to Vault then to the Character
                bool firstTransfer = await core.TransferItem(itemHash, itemID, stackSize, origin, true);
                bool secondTransfer = await core.TransferItem(itemHash, itemID, stackSize, destination, false);

                if (firstTransfer && secondTransfer)
                {
                    transferSuccess = true;
                }
            }

            if (transferSuccess)
            {
                // Update the item's location
                content.SetIdentifier(transfer, destination);
                DisplaySnackbar($"Successfully transferred {content.Details[transfer.ItemHash].DisplayProperties.Name} to {destination}.", Severity.Success);
            }
            else
            {
                DisplaySnackbar($"Unable to transfer {content.Details[transfer.ItemHash].DisplayProperties.Name} from {origin} to {destination}.", Severity.Error);
            }

            StateHasChanged();
        }
    }
}