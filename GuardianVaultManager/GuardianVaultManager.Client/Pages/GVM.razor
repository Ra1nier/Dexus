@code {
    // GVM Objects
    public static Core core = new Core();
    private bool initializationComplete = false;

    /// <summary>
    ///   First render start the core.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected async override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (core.OAuthStatus)
            {
                await LoadClientData();

                // Set initialization complete
                initializationComplete = true;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// When page loads or reloads fetch load all important information.
    /// </summary>
    protected override void OnInitialized()
    {
        core = Core.Instance;
    }

    /// <summary>
    /// Displays a snackbar message to the user.
    /// </summary>
    /// <param name="message">Message to send. Should not be long.</param>
    public void DisplaySnackbar(string message)
    {
        Snackbar.Add(message, Severity.Info);
    }

    /// <summary>
    /// Displays a snackbar message to the user. Will display message as the severity specified.
    /// </summary>
    /// <param name="message">Message to send. Should not be long.</param>
    /// <param name="mode">Severity to use.</param>
    public void DisplaySnackbar(string message, Severity mode)
    {
        Snackbar.Add(message, mode);
    }

    /// <summary>
    /// Loads the client data. This includes inventories, vault, and characters.
    /// </summary>
    private async Task LoadClientData()
    {
        // Fetch Characters
        await FetchClientCharacters();

        // Load Vault
        await LoadClientVault();

        // Load Inventories
        await LoadClientInventories();

        // Load Item Details
        await QueryManifestForDetails(DropzoneBackingStore);

        // Load Bucket Details and Sort
        await QueryManifestForBuckets(DropzoneBackingStore);
    }

    /// <summary>
    /// Starts the Sign In process at Bungie
    /// </summary>
    private void HandleSignIn()
    {
        Logger.LogDebug("Sign In Started");

        if (!core.OAuthStatus)
        {
            Navigation.NavigateTo(core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }

    /// <summary>
    /// Handles transfers of items from one bucket to another and informs the core of the change.
    /// </summary>
    /// <param name="item">Item being transferred</param>
    private async void Transfer(MudItemDropInfo<Item> item)
    {
        if (item.Item != null)
        {
            var transfer = item.Item;
            bool vaultTransfer;
            string origin;

            // Figure out the type of transfer
            if (item.DropzoneIdentifier == "Vault") // Character -> Vault
            {
                vaultTransfer = true;
                origin = item.Item.Identifier ?? string.Empty;
            }
            else // Vault -> Character
            {
                vaultTransfer = false;
                origin = item.DropzoneIdentifier;
            }

            // Item Transfer Identification
            uint itemHash = transfer.ItemHash;
            string itemID = transfer.ItemInstanceId ?? "-1";
            int stackSize = transfer.Quantity;

            // Initiate the transfer
            if (await core.TransferItem(itemHash, itemID, stackSize, origin, vaultTransfer))
            {
                // Change location to new dropzone
                item.Item.Identifier = item.DropzoneIdentifier;
                DisplaySnackbar($"Successfully transferred {ItemDetails[transfer.ItemHash].DisplayProperties.Name} to {item.DropzoneIdentifier}.", Severity.Success);
            }
            else
            {
                DisplaySnackbar($"Failed to transfer {ItemDetails[transfer.ItemHash].DisplayProperties.Name} to {item.DropzoneIdentifier}.", Severity.Error);
            }

            StateHasChanged();
        }
    }

    /// <summary>
    /// Gets clients character information from bungie.
    /// </summary>
    private async Task FetchClientCharacters()
    {
        try
        {
            string charactersJson = await core.GetCharacters();
            JsonDocument charactersContent = JsonDocument.Parse(charactersJson);
            JsonElement characters = charactersContent.RootElement.GetProperty("Response").GetProperty("characters").GetProperty("data");

            foreach (JsonProperty characterJson in characters.EnumerateObject())
            {
                if (characterJson.Value.ValueKind != JsonValueKind.Null)
                {
                    var characterDetails = characterJson.Value;

                    // Deserialize character details
                    var character = JsonSerializer.Deserialize<Character>(characterDetails);

                    if (character != null)
                    {
                        // Assign the character ID manually
                        character.CharacterId = characterJson.Name;
                        // character.Class = await core.GetCharacterClass(character.ClassHash);
                        Characters.Add(character);
                    }
                }
                else
                {
                    Logger.LogWarning($"Character details for ID {characterJson.Name} are null.");
                }
            }

            if (Characters.Count == 0)
            {
                DisplaySnackbar($"GVM Could not load you Guardians.", Severity.Error);
            }
        }
        catch (Exception e)
        {
            Logger.LogError($"GVM was unable to retrieve the client's characters: {e.Message}");
        }
    }

    /// <summary>
    /// Creates the clients character inventory contents from bungie.
    /// </summary>
    private async Task LoadClientInventories()
    {
        try
        {
            // Fetch Inventories contents
            string inventoriesContentsJson = await core.GetCharactersInventories();
            JsonDocument inventoriesContents = JsonDocument.Parse(inventoriesContentsJson);
            JsonElement charactersArray = inventoriesContents.RootElement.GetProperty("Response").GetProperty("characterInventories").GetProperty("data");

            // Populate Inventories list
            int itemsLoaded = 0;
            foreach (Character character in Characters)
            {
                if (character.CharacterId != null)
                {
                    JsonElement characterInventory = charactersArray.GetProperty(character.CharacterId).GetProperty("items");

                    foreach (JsonElement itemJson in characterInventory.EnumerateArray())
                    {
                        Item item = JsonSerializer.Deserialize<Item>(itemJson) ?? new Item();
                        item.Identifier = character.CharacterId;
                        DropzoneBackingStore.Add(item);

                        itemsLoaded++;
                    }
                }
            }

            Logger.LogInformation($"Loaded {itemsLoaded} items into Inventories.");

            if (itemsLoaded != 0)
            {
                DisplaySnackbar($"Loaded {itemsLoaded} items into Inventories.");
            }
            else
            {
                DisplaySnackbar($"Could not load your Inventories. Try reloading the page.", Severity.Warning);
            }
        }
        catch (Exception e)
        {
            Logger.LogError($"GVM was unable to retrieve the client's inventories: {e.Message}");
        }
    }

    /// <summary>
    /// Creates the clients vault contents from bungie.
    /// </summary>
    private async Task LoadClientVault()
    {
        try
        {
            // Fetch vault contents
            string vaultContentsJson = await core.GetVaultContents();
            JsonDocument vaultContents = JsonDocument.Parse(vaultContentsJson);
            JsonElement vaultArray = vaultContents.RootElement.GetProperty("Response").GetProperty("profileInventory").GetProperty("data").GetProperty("items");

            // Populate Vault list
            int itemsLoaded = 0;
            foreach (JsonElement itemElement in vaultArray.EnumerateArray())
            {
                Item item = JsonSerializer.Deserialize<Item>(itemElement) ?? new Item();
                item.Identifier = "Vault";
                DropzoneBackingStore.Add(item);

                itemsLoaded++;
            }

            Logger.LogInformation($"Loaded {itemsLoaded} items into Vault.");

            if (itemsLoaded != 0)
            {
                DisplaySnackbar($"Loaded {itemsLoaded} items into Vault.");
            }
            else
            {
                DisplaySnackbar($"Could not load your Vault. Try reloading the page.", Severity.Warning);
            }
        }
        catch (Exception e)
        {
            Logger.LogError($"GVM was unable to retrieve the client's vault: {e.Message}");
        }
    }

    /// <summary>
    /// Creates a dictionary for the clients weapons.
    /// </summary>
    /// <param name="items">List of the clients weapons.</param>
    private async Task QueryManifestForDetails(List<Item> items)
    {
        Logger.LogInformation("Getting Clients Weapon Information.");
        foreach (Item item in items)
        {
            uint itemHash = item.ItemHash;

            if (!ItemDetails.TryGetValue(itemHash, out _))
            {
                var itemDetails = await core.GetWeaponDetails(itemHash);

                if (itemDetails.Equals(new ItemDetails()))
                {
                    DisplaySnackbar("GVM is unable to define an item.");
                }

                ItemDetails.Add(itemHash, itemDetails);
            }
        }
    }

    /// <summary>
    /// Assigns each item in the given list into their buckets.
    /// </summary>
    /// <param name="items">List to assign buckets to.</param>
    private async Task QueryManifestForBuckets(List<Item> items)
    {
        Logger.LogInformation("Getting Bucket Information.");
        foreach (Item item in items)
        {
            uint hash = item.ItemHash;
            if (ItemDetails.ContainsKey(hash))
            {
                var itemDetails = ItemDetails[hash];
                item.Bucket = await core.GetBucketDefinition(itemDetails.Inventory.BucketTypeHash);
                SortIntoSubComponent(item);
            }
            else
            {
                Logger.LogWarning($"Bucket not found for item: {item.ItemHash}, BucketHash: {item.BucketHash}");
            }
        }

        // Combine appropriate Lists (TODO May not be needed)
        Weapons.AddRange(KineticWeapons);
        Weapons.AddRange(EnergyWeapons);
        Weapons.AddRange(PowerWeapons);

        Armor.AddRange(Helmets);
        Armor.AddRange(Gauntlets);
        Armor.AddRange(Chests);
        Armor.AddRange(Legs);
        Armor.AddRange(Skirts);

        ClientComponents.AddRange(Consumables);
        ClientComponents.AddRange(Extras);
    }

    /// <summary>
    /// Sorts everything in the list to the appropriate sub categories.
    /// </summary>
    /// <param name="item">Item to sort into components.</param>
    private void SortIntoSubComponent(Item item)
    {
        // Sort Items into buckets
        if (!string.IsNullOrEmpty(item.Bucket))
        {
            switch (item.Bucket)
            {
                case "Kinetic Weapons":
                    KineticWeapons.Add(item);
                    break;
                case "Energy Weapons":
                    EnergyWeapons.Add(item);
                    break;
                case "Power Weapons":
                    PowerWeapons.Add(item);
                    break;

                case "Helmet":
                    Helmets.Add(item);
                    break;
                case "Gauntlets":
                    Gauntlets.Add(item);
                    break;
                case "Chest Armor":
                    Chests.Add(item);
                    break;
                case "Leg Armor":
                    Legs.Add(item);
                    break;
                case "Class Armor":
                    Skirts.Add(item);
                    break;

                case "Lost Items":
                    Postmaster.Add(item);
                    break;

                case "Ghost":
                case "Ships":
                case "Vehicle":
                case "Emblems":
                case "Accessories":
                    Accessories.Add(item);
                    break;

                case "Engrams":
                    Engrams.Add(item);
                    break;

                case "Strange Coin":
                case "Glimmer":
                case "Legendary Shards":
                case "Silver":
                case "Bright Dust":
                case "Wrapped Items":
                case "Materials":
                case "Synthweave Bolt":
                case "Synthweave Strap":
                case "Synthweave Plate":
                case "Synthweave Template":
                case "Consumables":
                    Consumables.Add(item);
                    break;

                case "Messages":
                case "Special Orders":
                case "Quests":
                    Quests.Add(item);
                    break;

                default:
                    Extras.Add(item);
                    break;
            }
        }
    }
}