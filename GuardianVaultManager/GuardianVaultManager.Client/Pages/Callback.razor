@page "/callback"

@using Microsoft.AspNetCore.WebUtilities
@using GuardianVaultManager.Client.Pages;
@using System.Diagnostics

@inject NavigationManager Navigation

<h3>Processing your sign-in...</h3>

@code {
    private bool _oauthCalled = false;

    protected override void OnInitialized()
    {
        if (_oauthCalled) // Prevent further calls to StartOAuth
            return;

        _oauthCalled = true;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);

        if (queryParams.TryGetValue("code", out var code))
        {
            Debug.WriteLine("CallBack..............................");
            GVM.core.StartOAuth(code);

            // Use Task.Run with a delay to perform navigation asynchronously
            Task.Run(async () =>
            {
                await Task.Delay(1000); // Tiny delay to allow rendering to complete
                Navigation.NavigateTo("/GVM");
            });
        }
        else
        {
            Console.WriteLine("No authorization code found in the query string.");
        }
    }
}
