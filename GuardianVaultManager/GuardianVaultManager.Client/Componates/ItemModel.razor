@using ContentManager.Models
@using GuardianVaultManagerCore

@inject NavigationManager NavManager

<!-- Main Display -->
<MudCard Style="width: 80px; height: 80px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; position: relative;" Elevation="4" @onclick="() => TogglePopover(itemModelID)">
    <MudCardMedia Image="@Core.Content.Details[Item.ItemHash].DisplayProperties.Icon" alt="Weapon" Style="width: 100%; height: 100%; object-fit: cover;" />
    @if (Item.Power != 0)
    {
        @if (Core.Settings.Check("WeaponStyle-Tag"))
        {
            <div style="position: absolute; right: 0%; background: rgba(0, 0, 0, 0.6); color: white; padding: 2px 2px 0px 10px; font-size: 12px; clip-path: polygon(0 0, 100% 0%, 100% 100%, 30% 100%);">@Item.Power</div>
        }
        else
        {
            <div style="position: absolute; top: 4px; right: 4px; background: rgba(0, 0, 0, 0.6); color: white; padding: 2px 6px; font-size: 12px; border-radius: 4px;">@Item.Power</div>
        }
    }

    @if (Core.Settings.Check("Weapon-Names"))
    {
        <MudCardContent Style="text-align: center; padding: 4px;">
            <MudText Typo="Typo.body2" Style="font-size: 10px;">@Core.Content.Details[Item.ItemHash].DisplayProperties.Name</MudText>
        </MudCardContent>
    }
</MudCard>

<!-- Popover for Info and Actions for the Item -->
<!-- Popover for Info and Actions for the Item -->
<MudPopover Open="@(activeItemId == itemModelID)" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter">
    <MudPaper Class="pa-4" Style="min-width: 250px; border-radius: 8px; box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <MudText Typo="Typo.h6">@Core.Content.Details[Item.ItemHash].DisplayProperties.Name</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="()=>activeItemId = null" Size="Size.Small"/>
        </div>

        <!-- Perk Details -->
        <MudCard Class="mt-2" Style="border: none; box-shadow: none; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 6px;">
            <MudCardContent Style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;">
                @foreach (var perk in Item.Perks)
                {
                    string iconPath = $"https://www.bungie.net{perk.IconPath}";
                    <MudTooltip Text="Placeholder for perk name">
                        <MudIconButton Style="width: 80px; height: 80px;" OnClick="SelectPerk">
                            <img src="@iconPath" alt="Perk Icon" style="width: 100%; height: 100%; object-fit: contain;" />
                        </MudIconButton>
                    </MudTooltip>
                }
            </MudCardContent>
        </MudCard>

        <!-- Transfer Menu -->
        <MudMenu Icon="@Icons.Material.Outlined.IosShare" ActivationEvent="@MouseEvent.MouseOver" Class="mx-2 mt-2">
            <ChildContent>
                @foreach (Character character in Core.Content.Characters.Values.Where(c => c.CharacterId != Item.Identifier))
                {
                    <MudButton Disabled="@processing" Tag=@character.CharacterId OnClick="() => Transfer(character.CharacterId ?? string.Empty)" Variant="Variant.Filled" Color="Color.Primary" Class="mb-1">
                        @if (processing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Transferring...</MudText>
                        }
                        else
                        {
                            <MudText>@character.Class</MudText>
                        }
                    </MudButton>
                }
            </ChildContent>
        </MudMenu>

        <!-- Pull From Postmaster -->
        @if (Item.Bucket == "Lost Items")
        {
            <MudButton Color="Color.Warning" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowDown" OnClick="() => PullFromPostmaster()" Class="mt-2">
                Pull From Postmaster
            </MudButton>
        }
    </MudPaper>
</MudPopover>


@code {
    /// <summary>
    /// The Item to be represented by this model.
    /// </summary>
    [Parameter] public required Item Item { get; set; }

    /// <summary>
    /// Singleton instance of the Core service.
    /// </summary>
    [Parameter] public required Core Core { get; set; }

    // Property Popover locks
    private static Guid? activeItemId = null;
    private Guid itemModelID = Guid.NewGuid();

    // Item variables
    bool processing = false;

    private void TogglePopover(Guid itemId)
    {
        if (activeItemId == itemId)
        {
            activeItemId = null; // TODO: Clicking the same item closes it, at least it is supposed to but it aint working
        }
        else
        {
            activeItemId = itemId; // TODO: Clicking a different item switches the popover, at least it is supposed to but it aint working
        }
    }

    /// <summary>
    /// Transfers the item being represented to the destination provided.
    /// </summary>
    /// <param name="destination">Location to transfer the item to.</param>
    private async Task Transfer(string destination)
    {
        if (!(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        string origin = Item.Identifier ?? string.Empty;

        string characterName = Core.Content.Characters.FirstOrDefault(x => x.Value.CharacterId == destination).Value.Class ?? destination;
        Core.Snackbar.AddMessage($"Transferring {Core.Content.Details[Item.ItemHash].DisplayProperties.Name} to {characterName}.", "Info");

        string itemID = Core.Content.QueueTransfer(Item, origin, destination);

        while (Core.Content.GetTransferStatus(itemID) == 2)
        {
            await Task.Delay(100);
        }

        if (Core.Content.GetTransferStatus(itemID) == 0)
        {
            Core.Snackbar.AddMessage($"Transfer of {Core.Content.Details[Item.ItemHash].DisplayProperties.Name} to {characterName} was Successful.", "Success");
        }

        this.StateHasChanged();
    }

    /// <summary>
    /// Pulls the item from postmaster.
    /// </summary>
    private async Task PullFromPostmaster()
    {
        if (!(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        Core.Snackbar.AddMessage($"Pulling {Core.Content.Details[Item.ItemHash].DisplayProperties.Name} from Postmaster.", "Info");

        if (await Core.Content.PullFromPostmaster(this.Item))
        {
            Core.Snackbar.AddMessage($"Successfully pulled {Core.Content.Details[Item.ItemHash].DisplayProperties.Name} from Postmaster.", "Success");
        }
    }

    /// <summary>
    /// Selects the perk oon the item.
    /// </summary>
    private async Task SelectPerk()
    {
        if (!(await Core.ConfirmOAuthStatus()))
        {
            return;
        }
        
        // TODO: Add functionality to change an items perk in Content Manager.
        return;
    }
}