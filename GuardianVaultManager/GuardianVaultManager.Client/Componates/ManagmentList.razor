@using MudBlazor
@using RequestManager
@using ContentManager
@using ContentManager.Models
@using GuardianVaultManagerCore
@using GuardianServices;

<MudPaper Class="d-flex flex-column gap-2" @key="RenderKey">
    <MudDropContainer T="Item" Items="Items.OrderByDescending(item => item.Power)" ItemsSelector="@((item,dropzone) => item.Identifier == dropzone)" ItemDropped="Transfer" Class="d-flex flex-wrap flex-grow-1">
        <ChildContent>
            <MudGrid Class="d-flex" Justify="Justify.SpaceBetween">
                @foreach (var character in Core.Content.Characters)
                {
                    <MudItem xs="6" sm="3" md="2" lg="2" Class="d-flex flex-column">
                        @{
                            string equipped = character.Value.CharacterId + "Equipped";
                        }
                        <MudDropZone T="Item" Identifier="@equipped" Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1" Style="height: 15%; width: 100%;"></MudDropZone>
                        <MudDropZone T="Item" Identifier="@character.Value.CharacterId" Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1" Style="height: 85%; width: 100%;"></MudDropZone>
                    </MudItem>
                }
                <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column">
                    @if ((Items.Where(x => x.Identifier == "Vault").Count()) > 0)
                    {
                        <MudDropZone T="Item" Identifier="Vault" Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1" Style="min-width: 50%; height: 100%;" />
                    }
                </MudItem>
            </MudGrid>
        </ChildContent>
        <ItemRenderer>
            <ItemModel Item=@context Core=@Core />
        </ItemRenderer>
    </MudDropContainer>
</MudPaper>

@code {
    [Parameter] public required Guid RenderKey { get; set; }
    [Parameter] public required IEnumerable<Item> Items { get; set; }
    [Parameter] public required Core Core { get; set; }

    string transferStatusMessage = string.Empty;

    /// <summary>
    /// Handles transfers of items between buckets and informs the core of the change.
    /// Supports Vault to Character, Character to Vault, and Character to Character transfers.
    /// </summary>
    /// <param name="item">Item being transferred.</param>
    private async void Transfer(MudItemDropInfo<Item> item)
    {
        if (item.Item != null)
        {
            Item transfer = item.Item;

            // Item bucket Identification
            string origin = transfer.Identifier ?? string.Empty;
            string destination = item.DropzoneIdentifier;

            if ((destination == origin) || !(await Core.ConfirmOAuthStatus()))
            {
                return;
            }

            string transferBucket = destination;
            if (destination != "Vault")
            {
                transferBucket = Core.Content.Characters.FirstOrDefault(x => x.Value.CharacterId == destination.Replace("Equipped", string.Empty)).Value.Class ?? destination;
            }

            Core.Snackbar.AddMessage($"Transfering {Core.Content.Details[transfer.ItemHash].DisplayProperties.Name} to {transferBucket}.", "Info");

            if (await Core.Content.Transfer(transfer, origin, destination))
            {
                RenderKey = Guid.NewGuid();
                Core.Snackbar.AddMessage($"Transfer of {Core.Content.Details[transfer.ItemHash].DisplayProperties.Name} to {transferBucket} was Succesful.", "Success");
            }

            this.StateHasChanged();
        }
    }
}