@using ContentManager.Models
@using GuardianVaultManagerCore

<MudPaper Class="d-flex flex-column gap-2" @key="RenderKey">
    <MudDropContainer T="Item" Items="Items.OrderByDescending(item => item.Power)"
                      ItemsSelector="@((item, dropzone) => item.Identifier == dropzone)" ItemDropped="Transfer"
                      Class="d-flex flex-wrap flex-grow-1">
        <ChildContent>
            <MudGrid Class="d-flex" Justify="Justify.SpaceBetween">
                @foreach (var character in Core.Content.Characters)
                {
                    <MudItem xs="6" sm="3" md="2" lg="2" Class="d-flex flex-column">
                        @{
                            string equipped = character.Value.CharacterId + "Equipped";
                        }
                        <MudDropZone T="Item" Identifier="@equipped"
                                     Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1"
                                     Style="height: 15%; width: 100%;"></MudDropZone>
                        <MudDropZone T="Item" Identifier="@character.Value.CharacterId"
                                     Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1"
                                     Style="height: 85%; width: 100%;"></MudDropZone>
                    </MudItem>
                }
                <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column">
                    @if (Items.Count(x => x.Identifier == "Vault") > 0)
                    {
                        <MudDropZone T="Item" Identifier="Vault"
                                     Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1"
                                     Style="min-width: 50%; height: 100%;"/>
                    }
                </MudItem>
            </MudGrid>
        </ChildContent>
        <ItemRenderer>
            <ItemModel Item=@context Core=@Core/>
        </ItemRenderer>
    </MudDropContainer>
</MudPaper>

@code {

    /// <summary>
    /// Render key that determines if the content in the management list needs to be refreshed
    /// </summary>
    [Parameter]
    public required Guid RenderKey { get; set; }

    /// <summary>
    /// The items to display in the management list
    /// </summary>
    [Parameter]
    public required IEnumerable<Item> Items { get; set; }

    /// <summary>
    /// The singleton instance of core that GVM uses.
    /// </summary>
    [Parameter]
    public required Core Core { get; set; }

    /// <summary>
    /// Handles transfers of items between buckets and informs the core of the change.
    /// Supports Vault to Character, Character to Vault, and Character to Character transfers.
    /// </summary>
    /// <param name="item">Item being transferred.</param>
    private async void Transfer(MudItemDropInfo<Item> item)
    {
        if (item.Item == null || !Core.Content.TransfersAllowed || !(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        Item transfer = item.Item;

        // Item bucket Identification
        string origin = transfer.Identifier ?? string.Empty;
        string destination = item.DropzoneIdentifier;

        if ((destination == origin) || !(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        string transferBucket = destination;
        if (destination != "Vault")
        {
            transferBucket = Core.Content.Characters.FirstOrDefault(x => x.Value.CharacterId == destination.Replace("Equipped", string.Empty)).Value.Class ?? destination;
        }

        Core.Snackbar.AddMessage($"Transferring {Core.Content.ItemDetails[transfer.ItemHash].DisplayProperties.Name} to {transferBucket}.", "Info");

        string itemID = Core.Content.QueueTransfer(transfer, origin, destination);

        while (Core.Content.GetTransferStatus(itemID) == 2)
        {
            await Task.Delay(100);
        }

        if (Core.Content.GetTransferStatus(itemID) == 0)
        {
            RenderKey = Guid.NewGuid();
            Core.Snackbar.AddMessage($"Transfer of {Core.Content.ItemDetails[transfer.ItemHash].DisplayProperties.Name} to {transferBucket} was Successful.", "Success");
        }

        this.StateHasChanged();
    }

}