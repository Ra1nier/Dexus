@using Dexus.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationState
@inject BungieSessionStore Sessions
@inject ClientProfile.Profile Profile
@inject DexusCore.Core Core
@inject NavigationManager Navigation

@if (initialized)
{
    <Routes />
}

@code {
    private bool initialized;

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Equals("demo", StringComparison.OrdinalIgnoreCase))
        {
            initialized = true;
            return;
        }

        var authentication = await AuthenticationState.GetAuthenticationStateAsync();
        var session = Sessions.Find(authentication.User);
        if (session is not null)
        {
            Profile.BindTo(session);
            await Core.SignIn();
        }
        initialized = true;
    }
}
