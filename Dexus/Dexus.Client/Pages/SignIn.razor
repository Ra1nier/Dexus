@page "/SignIn"
@rendermode InteractiveServer

@using DexusCore

@inject NavigationManager Navigation
@inject ILogger<SignIn> Logger

<PageTitle>Sign In</PageTitle>

<!-- Sign In -->
<MudContainer Class="d-flex flex-column justify-content-center bg-dark">
    <MudCard Class="text-center" Elevation="12" Style="max-width: 420px; border-radius: 12px;">
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom Class="text-primary">Guardian Vault Manager</MudText>
            <MudText Typo="Typo.body1" Class="mb-4 text-muted">
                Welcome to Dexus! Unfortunately in order to use this app we need access to your Bungie data which you have not given us permission to do :(.
                Would you kindly sign in so we can, you know... "manage" your data?
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSignIn" Class="mt-2 px-4 py-2"
                       StartIcon="@Icons.Material.Filled.Lock">
                Sign In with Bungie
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code
{
    /// <summary>
    /// Holds the singleton instance of core that Dexus uses.
    /// </summary>
    private static Core Core = new Core();

    /// <summary>
    /// Handles the first render of the webpage.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected override void OnAfterRender(bool firstRender)
    {
        // if (Core.OAuthStatus != 2)
        // {
        //     if (await Core.ConfirmOAuthStatus())
        //     {
        //         Navigation.NavigateTo("");
        //     }
        // }

        StateHasChanged();
    }

    /// <summary>
    /// When page loads or reloads fetch load all important information.
    /// </summary>
    protected override void OnInitialized()
    {
        Core = Core.Instance;
    }

    /// <summary>
    /// Starts the Sign-In process at Bungie.
    /// </summary>
    private void HandleSignIn()
    {
        Logger.LogDebug("Sign In Started");

        if (Core.OAuthStatus > 0)
        {
            Navigation.NavigateTo(Core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }
}