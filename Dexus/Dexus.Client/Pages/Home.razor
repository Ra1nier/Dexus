@page "/"
@rendermode InteractiveServer

@using DexusCore
@using UIServices

@inject NavigationManager Navigation
@inject DialogUIService DialogUIService
@inject Core Core
@inject UICore UICore

<PageTitle>Dexus</PageTitle>

<!-- Main content -->
<MudContainer Fixed="true">
    <MudPaper Height="400px" Width="100%" Square="true">This Page is under construction.</MudPaper>
</MudContainer>

@code
{
    /// <summary>
    /// Handles the first render of the webpage.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        
        await UICore.VerifyAPIAvaliablity();
    }

    /// <summary>
    /// When page loads or reloads.
    /// </summary>
    protected override void OnInitialized()
    {
    }
}
