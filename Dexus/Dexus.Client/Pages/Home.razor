@page "/"

@using DexusCore

@inject NavigationManager Navigation

<PageTitle>Dexus</PageTitle>

<!-- Main content -->
<MudContainer Fixed="true">
    <MudPaper Height="400px" Width="100%" Square="true">This Page is under construction.</MudPaper>
</MudContainer>

@code
{
    /// <summary>
    /// Holds the singleton instance of core that Dexus uses.
    /// </summary>
    private static Core Core = new Core();
    
    /// <summary>
    /// Handles the first render of the webpage.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected async override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || Core.OAuthStatus == 2)
        {
            Navigation.NavigateTo("/SignIn");
        }

        if (Core.OAuthStatus == 1)
        {
            if (!await Core.ConfirmOAuthStatus())
                Navigation.NavigateTo("/SignIn");
        }
    }

    /// <summary>
    /// When page loads or reloads fetch load all important information.
    /// </summary>
    protected override void OnInitialized()
    {
        Core = Core.Instance;
    }
}
