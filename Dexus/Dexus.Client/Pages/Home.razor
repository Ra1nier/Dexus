@page "/"
@rendermode InteractiveServer

@using DexusCore
@using Dexus.Client.Flairs.DialogBoxes

@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject Core Core

<PageTitle>Dexus</PageTitle>

<!-- Main content -->
<MudContainer Fixed="true">
    <MudPaper Height="400px" Width="100%" Square="true">This Page is under construction.</MudPaper>
</MudContainer>

@code
{
    /// <summary>
    /// Handles the first render of the webpage.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        
        switch (Core.OAuthStatus)
        {
            case 3:
                await OpenWarningDialog("No API Tokens.", "Dexus does not have any saved API Tokens for Bungie. Would you like to be redirected to a page where they can be inputted?", () => { Navigation.NavigateTo("/DexusAccount?signInRedirect=false&inputTokenRedirect=true"); });
                return;
            case 2:
                await OpenWarningDialog("Not Authorized with Bungie.", "You have not authorized Dexus to access your Bungie information or authorization has expired. Would you like to be redirected to the sign in page?", () => { Navigation.NavigateTo("/DexusAccount?signInRedirect=true&inputTokenRedirect=false"); });
                return;
            case 1:
            {
                if (!await Core.ConfirmOAuthStatus())
                    await OpenWarningDialog("Not Authorized with Bungie.", "You have not authorized Dexus to access your Bungie information or authorization has expired. Would you like to be redirected to the sign in page?", () => { Navigation.NavigateTo("/DexusAccount?signInRedirect=true&inputTokenRedirect=false"); });
                break;
            }
        }
    }

    /// <summary>
    /// When page loads or reloads.
    /// </summary>
    protected override void OnInitialized()
    {
    }
    
    /// <summary>
    /// Opens a warning dialog with the given title and message. If the user accepts the dialog, the given action will be invoked.
    /// </summary>
    /// <param name="title">Title of the dialog.</param>
    /// <param name="message">Message body.</param>
    /// <param name="action">A Lambda/Action that should be invoked.</param>
    /// <returns>A Task representing the dialog.</returns>
    private async Task OpenWarningDialog(string title, string message, Action action)
    {
        var parameters = new DialogParameters
        {
            { nameof(WarningDialog.Title), title },
            { nameof(WarningDialog.Message), message }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<WarningDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            action.Invoke();
        }
    }
    
    /// <summary>
    /// Opens a message dialog with the given title and message.
    /// </summary>
    /// <param name="title">Title of the dialog.</param>
    /// <param name="message">Message body.</param>
    /// <returns>A Task representing the dialog.</returns>
    private Task OpenMessageDialog(string title, string message)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        
        var parameters = new DialogParameters
        {
            { nameof(MessageDialog.Title), title },
            { nameof(MessageDialog.Message), message }
        };

        return DialogService.ShowAsync<MessageDialog>(title, parameters, options);
    }
}
