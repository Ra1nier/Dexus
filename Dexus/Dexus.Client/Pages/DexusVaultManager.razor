@page "/DexusVaultManager"
@rendermode InteractiveServer

@using DexusCore
@using ContentManager
@using Dexus.Client.Componates

@inject NavigationManager Navigation
@inject ILogger<DexusVaultManager> Logger
@inject ISnackbar Snackbar

<PageTitle>Dexus Vault Manager</PageTitle>

<!--Main Content-->
@if (initializationComplete)
{
    <!--Main Vault Manager-->
    <MudContainer Fixed="true" MaxWidth="MaxWidth.ExtraLarge" Class="d-flex flex-column gap-3">
        <!--Guardian Manager Settings-->
        <MudPaper Style="overflow:hidden; position:relative;">
            <MudExpansionPanel Text="Manager Settings" MaxHeight="150">
                <MudTabs Outlined="true" MinimumTabWidth="20px">
                    <MudTabPanel Icon="@Icons.Material.Filled.Settings">
                        @foreach (string settingName in localSettings.Keys)
                        {
                            <MudSwitch T=bool @bind-Value="localSettings[settingName]" Label=@settingName
                                       Color="Color.Success"/>
                        }
                    </MudTabPanel>
                </MudTabs>
                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Filled"
                               Color="Color.Primary" Size="Size.Large" OnClick="ApplySettingsWithRefresh"/>
            </MudExpansionPanel>
        </MudPaper>

        <!-- Column Labels -->
        <MudGrid Class="d-flex justify-center" Justify="Justify.SpaceBetween">
            @foreach (var character in Content.Characters.Values)
            {
                <MudItem xs="6" sm="3" md="2" lg="2" Class="d-flex flex-column justify-center">
                    <MudText Typo="Typo.h6" Class="mb-1 text-center">@character.Class</MudText>
                    <MudImage ObjectFit=@ObjectFit.ScaleDown Src=@character.EmblemBackgroundPath Elevation="25"
                              Class="rounded-lg"/>
                </MudItem>
            }
            <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column justify-center">
                <MudText Typo="Typo.h6" Class="mb-1 text-center">Vault</MudText>
                <MudImage ObjectFit=@ObjectFit.ScaleDown Height="55" Src="Resources/VaultEmblem.png" Elevation="25"
                          Class="rounded-lg"/>
            </MudItem>
        </MudGrid>

        <!-- Postmaster Section -->
        <BucketList Items="Content.Postmaster.Values" Sorted="true" Core=@Core
                    RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Kinetic Weapons Section-->
        <ManagmentList Items="Content.KineticWeapons.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Energy Weapons Section -->
        <ManagmentList Items="Content.EnergyWeapons.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Power Weapons Section -->
        <ManagmentList Items="Content.PowerWeapons.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Helmets Section -->
        <ManagmentList Items="Content.Helmets.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Gauntlets Section -->
        <ManagmentList Items="Content.Gauntlets.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Chests Section -->
        <ManagmentList Items="Content.Chests.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Legs Section -->
        <ManagmentList Items="Content.Legs.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Class Items Section -->
        <ManagmentList Items="Content.Skirts.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Accessories Section -->
        <ManagmentList Items="Content.Accessories.Values" Core=@Core RenderKey=@Content.ItemManagementRenderKey/>

        <!-- Consumables Section -->
        <BucketList Items="Content.UninstantiatedItems" Sorted="false" Core=@Core
                    RenderKey=@Content.ItemManagementRenderKey/>
    </MudContainer>
}
else
{
    <!-- Vault loading Page -->
    <MudContainer Fixed="true" MaxWidth="MaxWidth.ExtraLarge" Class="d-flex flex-column gap-3 justify-center">
        @{
            Core.Loadingbars.GetLoadingBar("Main", out int progressValue, out int bufferValue, out string progressText);
            <MudProgressLinear Color="Color.Error" Buffer="true" Value="@progressValue" BufferValue="@bufferValue"
                               Class="my-7">
                @if (!string.IsNullOrEmpty(progressText))
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Dark">
                        <b>@progressText</b>
                    </MudText>
                }
            </MudProgressLinear>
        }
    </MudContainer>

    // <FactoryLoader Text="Stealing all of your info from Bungie..." Scale=3/> Not working because I suck at css. The age-old problem of centering a div :(
}


@code 
{
    /// <summary>
    /// Holds the singleton instance of core that Dexus uses.
    /// </summary>
    public static Core Core = new Core();

    /// <summary>
    /// Holds the singleton instance of Content Manager from Core that Dexus uses.
    /// </summary>
    public static ContentManager Content = new ContentManager();

    // DexusVaultManager Variables
    private bool initializationComplete;
    private Dictionary<string, bool> localSettings = new Dictionary<string, bool>();

    /// <summary>
    /// Handles the first render of the webpage.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first render of the webpage.</param>
    protected async override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        
        if (Core.OAuthStatus == 2)
        {
            Navigation.NavigateTo("/SignIn");
        }

        if (Core.OAuthStatus != 0)
        {
            if (!await Core.ConfirmOAuthStatus())
                Navigation.NavigateTo("/SignIn");
        }

        if (!initializationComplete)
        {
            await Content.InitializeUserContent();
            Content.AllowTransfers();
            InitializeSettings();
        }

        initializationComplete = true;
        StateHasChanged();
    }

    /// <summary>
    /// When page loads or reloads fetch load all important information.
    /// </summary>
    protected async override void OnInitialized()
    {
        Core = Core.Instance;
        Content = Core.Content;

        // Refresh user content
        if (initializationComplete)
        {
            await Content.RefreshUserContent();
        }

        // Final Checks
        await Core.ConfirmOAuthStatus();
        SnackbarProvider();
    }

    /// <summary>
    /// Refreshes the users content manager.
    /// </summary>
    public async Task RefreshUserContent()
    {
        await Content.RefreshUserContent();
        StateHasChanged();
    }

    /// <summary>
    /// Initializes the startup settings for the application.
    /// </summary>
    private void InitializeSettings()
    {
        localSettings = new Dictionary<string, bool>
        {
            { "Weapon-Names", false },
            { "WeaponStyle-Tag", false },
        };

        ApplySettings();
    }

    /// <summary>
    /// Applies the local settings and saves them to disk.
    /// </summary>
    /// <returns>True if completed successfully, False otherwise.</returns>
    private void ApplySettings()
    {
        Core.Settings.SetSettings(localSettings, false);
        if (!Core.Settings.SaveSettings())
        {
            Core.Snackbar.AddMessage("Failed to save settings.", "Error");
        }
    }

    /// <summary>
    /// Applies the local settings and saves them to disk.
    /// </summary>
    /// <returns>True if completed successfully, False otherwise.</returns>
    private void ApplySettingsWithRefresh()
    {
        Core.Settings.SetSettings(localSettings, false);
        if (!Core.Settings.SaveSettings())
        {
            Core.Snackbar.AddMessage("Failed to save settings.", "Error");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Starts the snackbar provider to display messages to the user.
    /// </summary>
    private void SnackbarProvider()
    {
        new Thread(async void () =>
        {
            try
            {
                while (true)
                {
                    await Task.Delay(1000);
                    while (Core.Snackbar.NextMessage(out string message, out string severity, out Action<SnackbarOptions> config))
                    {
                        Severity mode = (Severity)Enum.Parse(typeof(Severity), severity);
                        Snackbar.Add(message, mode, config);
                    }
                }
            }
            catch (Exception e)
            {
                Logger.LogError($"An unknown error occured when executing the Snackbar Task that has shutdown the task: {e.Message}");
            }
        }).Start();
    }
}