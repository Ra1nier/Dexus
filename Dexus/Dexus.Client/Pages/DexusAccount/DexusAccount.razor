@page "/DexusAccount"
@rendermode InteractiveServer

@using DexusCore
@using UIServices
@using MudBlazor

@inject NavigationManager Navigation
@inject ILogger<DexusAccount> Logger
@inject DialogUIService DialogUIService
@inject Core Core;

<MudContainer MaxWidth="MaxWidth.Large" Class="account-shell">
    <MudPaper Class="account-panel" Elevation="2">
        <MudText Typo="Typo.h4" Class="account-title">User Profile</MudText>

        <MudTabs Rounded="true" Centered="false" @bind-ActivePanelIndex="activeTabIndex">
            
            <MudTabPanel Text="Dexus Profile">
                <UserAccountPage />
            </MudTabPanel>

            <MudTabPanel Text="Bungie Account">
                <BungieAccountPage />
            </MudTabPanel>

            <MudTabPanel Text="Authorization">
                <OAuthPage />
            </MudTabPanel>
            
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Indicates whether the user has been redirected to the API Token page because they need to input tokens.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "goToTab")]
    public required int GoToTab { get; set; }

    // Account page specifics
    private int activeTabIndex = 0;

    /// <summary>
    /// Runs when the age is initializing.
    /// </summary>
    protected override void OnInitialized()
    {
        activeTabIndex = GoToTab;
    }
}

<style>
    .account-shell {
        padding: 24px 16px;
    }

    .account-panel {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 24px;
    }

    .account-title {
        font-weight: 600;
        margin-bottom: 18px;
    }
</style>
