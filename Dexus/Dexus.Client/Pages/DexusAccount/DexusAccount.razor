@page "/DexusAccount"
@rendermode InteractiveServer

@using DexusCore
@using UIServices
@using MudBlazor

@inject NavigationManager Navigation
@inject ILogger<DexusAccount> Logger
@inject DialogUIService DialogUIService
@inject Core Core;

<MudContainer MaxWidth="MaxWidth.Large" Class="m-4 p-4">
    <MudPaper Class="p-4 m-4" Elevation="3" Style="border-radius: 12px; margin: 24px; padding: 24px;">
        <MudText Typo="Typo.h4" Class="mb-3">User Profile</MudText>

        <MudTabs Rounded="true" Centered="false" @bind-ActivePanelIndex="activeTabIndex">
            
            <MudTabPanel Text="Dexus Profile">
                <UserAccountPage />
            </MudTabPanel>

            <MudTabPanel Text="Bungie Account">
                <BungieAccountPage />
            </MudTabPanel>

            <MudTabPanel Text="OAuthorization">
                <OAuthPage />
            </MudTabPanel>
            
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Indicates whether the user has been redirected to the API Token page because they need to input tokens.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "goToTab")]
    public required int GoToTab { get; set; }

    // Account page specifics
    private int activeTabIndex = 0;

    /// <summary>
    /// Runs when the age is initializing.
    /// </summary>
    protected override void OnInitialized()
    {
        activeTabIndex = GoToTab;
    }
}