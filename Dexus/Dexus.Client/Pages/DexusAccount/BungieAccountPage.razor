@using DexusCore

@inject Core Core

<MudItem xs="12" md="8" Class="mx-auto mt-6">
    <MudPaper Elevation="4" Class="p-6" Style="border-radius: 12px;">
        <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">Bungie Application Credentials</MudText>

        @if (Core.OAuthProfile.UsesConfiguredAPIKeys)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Bungie application credentials are configured by the server.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Bungie application credentials have not been configured for this deployment.
            </MudAlert>
        }

        <MudForm @ref="apiTokenForm">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="API Key"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.VpnKey"
                                  FullWidth="true"
                                  Disabled="@Core.OAuthProfile.UsesConfiguredAPIKeys"
                                  @bind-Value="APIKey"/>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Client ID"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.PermIdentity"
                                  FullWidth="true"
                                  Disabled="@Core.OAuthProfile.UsesConfiguredAPIKeys"
                                  @bind-Value="ClientID"/>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Client Secret"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  FullWidth="true"
                                  Disabled="@Core.OAuthProfile.UsesConfiguredAPIKeys"
                                  @bind-Value="ClientSecret"/>
                </MudItem>

                @if (!Core.OAuthProfile.UsesConfiguredAPIKeys)
                {
                    <MudItem xs="12" Class="d-flex justify-end mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveAPIKeys">
                            Save Changes
                        </MudButton>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudItem>

@code {
    private MudForm? apiTokenForm;
    private string APIKey = string.Empty;
    private string ClientID = string.Empty;
    private string ClientSecret = string.Empty;

    /// <summary>
    /// Runs when the age is initializing.
    /// </summary>
    protected override void OnInitialized()
    {
        APIKey = Core.OAuthProfile.UsesConfiguredAPIKeys ? "Configured by server" : Core.OAuthProfile.API_Key;
        ClientID = Core.OAuthProfile.UsesConfiguredAPIKeys ? Core.OAuthProfile.Client_ID : Core.OAuthProfile.Client_ID;
        ClientSecret = Core.OAuthProfile.UsesConfiguredAPIKeys ? "Configured by server" : Core.OAuthProfile.Client_Secret;
    }

    /// <summary>
    /// Saves the user API keys to the OAuthProfile
    /// </summary>
    private async Task SaveAPIKeys()
    {
        if (Core.OAuthProfile.UsesConfiguredAPIKeys)
            return;

        if (apiTokenForm is null)
            return;

        await apiTokenForm.Validate();

        if (apiTokenForm.IsValid)
        {
            Core.SetOAuthKeys(APIKey, ClientID, ClientSecret);
        }
    }

}
