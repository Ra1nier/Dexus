@using DexusCore
@inject Core Core

<MudPaper Class="pa-6 mx-auto" Elevation="0">
    <MudText Typo="Typo.h6">Bungie connection</MudText>
    <MudAlert Severity="Severity.Info" Class="mt-4">
        @(Core.OAuthProfile.UsesConfiguredAPIKeys
            ? "Bungie sign-in is configured by the server."
            : "Bungie sign-in is waiting for the server’s application credentials.")
    </MudAlert>
</MudPaper>
