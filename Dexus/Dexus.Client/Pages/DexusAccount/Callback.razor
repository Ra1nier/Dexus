@page "/callback"

@using Dexus.Client.UIServices
@using Microsoft.AspNetCore.WebUtilities
@using DexusCore

@inject NavigationManager Navigation
@inject ILogger<Callback> Logger;
@inject DialogUIService DialogService;
@inject Core Core;
@inject IJSRuntime JS;

<style>
    .oauth-callback-shell {
        min-height: calc(100vh - 96px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
    }

    .oauth-callback-card {
        width: min(520px, 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 32px;
        text-align: center;
    }

    .loader {
        width: 32px;
        height: 16px;
        display: flex;
        justify-content: center;
        margin: 28px auto;
    }

    .loader:before,
    .loader:after {
        content: "";
        flex: 1;
        background: #3FB8AF;
        transform-origin: top right;
        animation: l10-1 2s infinite;
    }

    .loader:after {
        background: #FF3D7F;
        transform-origin: top left;
        animation-delay: .25s;
    }

    @@keyframes l10-1 {
        0%, 5% {
            transform: rotate(0);
        }

        20%, 30% {
            transform: rotate(90deg);
        }

        45%, 55% {
            transform: rotate(180deg);
        }

        70%, 80% {
            transform: rotate(270deg);
        }

        95%, 100% {
            transform: rotate(360deg);
        }
    }
</style>

<!-- Centered container -->
<MudContainer MaxWidth="MaxWidth.Medium" Class="oauth-callback-shell">
    <MudPaper Elevation="4" Class="oauth-callback-card">
        <MudText Typo="Typo.h5" Class="mb-2" Color="Color.Primary">@message</MudText>
        <div class="loader"></div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Please do not close this window.</MudText>
    </MudPaper>
</MudContainer>

@code {

    // local vars
    private string message = "Authorizing Bungie account...";
    private string reason = "We dont know what happened. You should not be seeing this.";
    private bool hasStartedOAuth = false;

    /// <summary>
    /// Activates after the component has been rendered.
    /// </summary>
    /// <returns>A Task representing the process.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasStartedOAuth)
        {
            return;
        }

        hasStartedOAuth = true;

        bool result = await HandleOAuth();

        if (!result)
        {
            UpdateMessage("Something went wrong with Authorization...");
            DialogService.SendDialog("Sorry it's not you... It's us.", $"Something went wrong with Bungie Authorization. {reason}. Unfortunately, this means is that authorization cannot continue safely. Try restarting Dexus to resolve this issue.");
            return;
        }

        UpdateMessage("Welcome to Dexus. Authorization completed successfully! Redirecting you back to the account page...");
        await Task.Delay(1000);
        Navigation.NavigateTo("/DexusAccount?goToTab=2");
    }

    /// <summary>
    /// Handles the exchange between the Bungie callback and the Dexus OAuthService.
    /// </summary>
    /// <returns>True if OAuth completed successfully, False otherwise.</returns>
    private async Task<bool> HandleOAuth()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        string? expectedState = await JS.InvokeAsync<string?>("sessionStorage.getItem", "dexus.oauth.state");

        if (!queryParams.TryGetValue("state", out var state) || state != expectedState)
        {
            Logger.LogCritical($"State val returned incorrect. REASON: {(state != expectedState ? "The state val from Bungie did not match dexus saved value." : "A state val was not returned.")}");
            reason = "Bungie either did not return the correct state value or did not return one at all";
            return false;
        }

        await JS.InvokeVoidAsync("sessionStorage.removeItem", "dexus.oauth.state");

        if (queryParams.TryGetValue("code", out var codeValue))
        {
            string? code = codeValue.FirstOrDefault();

            if (!string.IsNullOrEmpty(code))
            {
                Logger.LogDebug("Code retrieved. Starting Sign In");
                return await Core.StartOAuth(code);
            }
        }

        Logger.LogCritical($"Auth code returned incorrect. REASON: {(Core.OAuthStatus != 0 ? "Dexus post authorization failed." : "A invalid auth code was retuned.")}");
        reason = "Bungie's authorization code was not valid or did not give us one";
        return false;
    }

    /// <summary>
    /// Updates the splash text.
    /// </summary>
    /// <param name="newMessage">Message to update to.</param>
    private void UpdateMessage(string newMessage)
    {
        message = newMessage;
        StateHasChanged();
    }
}
