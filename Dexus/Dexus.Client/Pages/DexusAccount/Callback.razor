@page "/callback"

@using Dexus.Client.UIServices
@using Microsoft.AspNetCore.WebUtilities
@using DexusCore

@inject NavigationManager Navigation
@inject ILogger<Callback> Logger;
@inject DialogUIService DialogService;
@inject Core Core;

<style>
    /* Loader styles */
    .loader {
        width: 32px;
        height: 16px;
        display: flex;
        margin-top: 20px;
    }

    .loader:before,
    .loader:after {
        content: "";
        flex: 1;
        background: #3FB8AF;
        transform-origin: top right;
        animation: l10-1 2s infinite;
    }

    .loader:after {
        background: #FF3D7F;
        transform-origin: top left;
        animation-delay: .25s;
    }

    @@keyframes l10-1 {
        0%, 5% {
            transform: rotate(0);
        }

        20%, 30% {
            transform: rotate(90deg);
        }

        45%, 55% {
            transform: rotate(180deg);
        }

        70%, 80% {
            transform: rotate(270deg);
        }

        95%, 100% {
            transform: rotate(360deg);
        }
    }
</style>

<!-- Centered container -->
<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center min-vh-100 px-6">
    <MudPaper Elevation="6" Class="p-6 text-center"
              Style="border-radius: 16px; max-width: 480px; width: 100%; padding: 24px;">
        <MudText Typo="Typo.h5" Class="mb-2" Color="Color.Primary">@message</MudText>
        <div class="loader my-4"></div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Please do not close this window.</MudText>
    </MudPaper>
</MudContainer>

@code {

    // local vars
    private string message = string.Empty;
    private string reason = "We dont know what happened. You should not be seeing this.";
    private bool hasStartedOAuth = false;

    /// <summary>
    /// Activates after the component has been initialized.
    /// </summary>
    /// <returns>A Task representing the process.</returns>
    protected override async Task OnInitializedAsync()
    {
        if (hasStartedOAuth)
            return;

        hasStartedOAuth = true;

        Logger.LogInformation($"Dexus State val: {Core.OAuthProfile.State}");
        bool result = await HandleOAuth();
        Logger.LogInformation($"Dexus State val: {Core.OAuthProfile.State}");

        if (!result)
        {
            UpdateMessage("Something went wrong with Authorization...");
            DialogService.SendDialog("Sorry it's not you... It's us.", $"Something went wrong with Bungie Authorization. {reason}. Unfortunately, this means is that authorization cannot continue safely. Try restarting Dexus to resolve this issue.");
            return;
        }

        UpdateMessage("Welcome to Dexus. Authorization completed successfully! Redirecting you back to the account page...");
        await Task.Delay(1000);
        Navigation.NavigateTo("/DexusAccount?goToTab=2");
    }

    /// <summary>
    /// Handles the exchange between the Bungie callback and the Dexus OAuthService.
    /// </summary>
    /// <returns>True if OAuth completed successfully, False otherwise.</returns>
    private async Task<bool> HandleOAuth()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);

        if (!queryParams.TryGetValue("state", out var state) || state != Core.OAuthProfile.State)
        {
            Logger.LogCritical($"State val returned incorrect. REASON: {(state != Core.OAuthProfile.State ? "The state val from Bungie did not match dexus saved value." : "A state val was not returned.")}");
            reason = "Bungie either did not return the correct state value or did not return one at all";
            return false;
        }

        if (queryParams.TryGetValue("code", out var codeValue))
        {
            string? code = codeValue.FirstOrDefault();

            if (!string.IsNullOrEmpty(code))
            {
                Logger.LogDebug("Code retrieved. Starting Sign In");
                Core.StartOAuth(code);

                // Wait for OAuth to be completed before rerouting the user to the account page.
                while (Core.OAuthStatus != 0)
                {
                    await Task.Delay(500);
                }

                return true;
            }
        }

        Logger.LogCritical($"Auth code returned incorrect. REASON: {(Core.OAuthStatus != 0 ? "Dexus post authorization failed." : "A invalid auth code was retuned.")}");
        reason = "Bungie's authorization code was not valid or did not give us one";
        return false;
    }

    /// <summary>
    /// Updates the splash text.
    /// </summary>
    /// <param name="newMessage">Message to update to.</param>
    private void UpdateMessage(string newMessage)
    {
        message = newMessage;
        StateHasChanged();
    }
}
