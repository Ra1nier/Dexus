<MudGrid Spacing="3">
    <!-- Avatar -->
    <MudItem xs="12" md="4">
        <MudPaper Class="profile-card">
            <MudText Typo="Typo.subtitle1" Class="profile-card-title">Dexus Profile</MudText>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="profile-avatar-stack">
                <MudAvatar Size="Size.Large" Variant="Variant.Filled" Color="Color.Info">
                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                </MudAvatar>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Local demo profile
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Details -->
    <MudItem xs="12" md="8">
        <MudPaper Class="profile-card">
            <MudText Typo="Typo.subtitle1" Class="profile-card-title">Profile Details</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="First Name" Variant="Variant.Outlined" Disabled="true"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Last Name" Variant="Variant.Outlined" Disabled="true"/>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Profile Type" Variant="Variant.Outlined" Value="@profileType" Disabled="true"/>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Status" Variant="Variant.Outlined" Value="@profileStatus" Disabled="true"/>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private const string profileType = "Bungie OAuth profile";
    private const string profileStatus = "Managed by Dexus runtime";
}

<style>
    .profile-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        height: 100%;
        padding: 20px;
    }

    .profile-card-title {
        font-weight: 600;
        margin-bottom: 14px;
    }

    .profile-avatar-stack {
        padding: 20px 8px;
    }
</style>
