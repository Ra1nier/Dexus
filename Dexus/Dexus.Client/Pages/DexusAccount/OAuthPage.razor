@using DexusCore
@using UIServices

@inject Core Core
@inject ILogger<OAuthPage> Logger
@inject DialogUIService DialogUIService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudPaper Class="oauth-card mx-auto" Elevation="0">
    <MudText Typo="Typo.h5" Class="oauth-card-title">Bungie Sign-In</MudText>
    @if (Core.OAuthStatus == 0)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            You are signed in with Bungie. Your access tokens are active.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Logout"
                   OnClick="Logout">
            Sign Out
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mb-3 text-muted">
            You need to sign in with your Bungie.net account to access Destiny 2 profile data.
        </MudText>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="oauth-action-stack">
            <MudAvatar Size="Size.Large" Color="Color.Info">
                <MudIcon Color="Color.Dark" Icon="@Icons.Material.Filled.Lock" Size="Size.Large"/>
            </MudAvatar>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="HandleSignIn" StartIcon="@Icons.Material.Filled.Login">
                Sign In with Bungie
            </MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    
    /// <summary>
    /// Starts the Sign-In process at Bungie.
    /// </summary>
    private async Task HandleSignIn()
    {
        if (Core.OAuthStatus == 3)
        {
            DialogUIService.SendDialog("Bungie Sign-In is not available.", "This deployment has not been configured with Bungie application credentials yet.");
            return;
        }

        Logger.LogDebug("Sign In Started");

        if (Core.OAuthStatus > 0)
        {
            string state = Core.OAuthProfile.RefreshState();
            await JS.InvokeVoidAsync("sessionStorage.setItem", "dexus.oauth.state", state);
            Navigation.NavigateTo(Core.OAuthProfile.ConstructAuthorizationURL().ToString(), true);
        }
    }
    
    private void Logout()
    {
        Core.Logout();
    }
}

<style>
    .oauth-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        max-width: 640px;
        padding: 24px;
    }

    .oauth-card-title {
        font-weight: 600;
        margin-bottom: 12px;
    }

    .oauth-action-stack {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-top: 18px;
        padding: 28px;
    }
</style>
