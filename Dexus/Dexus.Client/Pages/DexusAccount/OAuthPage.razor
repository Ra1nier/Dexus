@using DexusCore
@using UIServices

@inject Core Core
@inject ILogger<OAuthPage> Logger
@inject DialogUIService DialogUIService
@inject NavigationManager Navigation

<MudPaper Class="oauth-card mx-auto" Elevation="0">
    <MudText Typo="Typo.h5" Class="oauth-card-title">Bungie Sign-In</MudText>
    @if (!string.IsNullOrEmpty(AuthError))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Sign-in could not be completed. Please try again and approve access to your Bungie account.
        </MudAlert>
    }
    @if (Core.OAuthStatus == 0)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            You are signed in with Bungie. Your access tokens are active.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/DexusVaultManager" Class="mb-4"
                   StartIcon="@Icons.Material.Filled.Inventory2">
            Open My Vault
        </MudButton>
        <form method="post" action="/auth/logout" data-enhance="false">
        <AntiforgeryToken />
        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Logout"
                   ButtonType="ButtonType.Submit">
            Sign Out
        </MudButton>
        </form>
    }
    else if (Core.OAuthStatus == 3)
    {
        <MudAlert Severity="Severity.Info">Bungie sign-in is waiting for the server’s application credentials.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mb-3 text-muted">
            You need to sign in with your Bungie.net account to access Destiny 2 profile data.
        </MudText>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="oauth-action-stack">
            <MudAvatar Size="Size.Large" Color="Color.Info">
                <MudIcon Color="Color.Dark" Icon="@Icons.Material.Filled.Lock" Size="Size.Large"/>
            </MudAvatar>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="HandleSignIn" StartIcon="@Icons.Material.Filled.Login">
                Sign In with Bungie
            </MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "authError")]
    public string? AuthError { get; set; }

    private void HandleSignIn() => Navigation.NavigateTo("/auth/bungie/start", forceLoad: true);
}

<style>
    .oauth-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        max-width: 640px;
        padding: 24px;
    }

    .oauth-card-title {
        font-weight: 600;
        margin-bottom: 12px;
    }

    .oauth-action-stack {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-top: 18px;
        padding: 28px;
    }
</style>
