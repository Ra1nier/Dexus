@using GuardianServices.Models
@using DexusCore

@inject Core Core

<MudPaper Class="management-shelf" @key="RenderKey">
    <MudDropContainer T="DItem" Items="Items.OrderByDescending(item => item.Power)"
                      ItemsSelector="@((item, dropzone) => item.Identifier == dropzone)" ItemDropped="Transfer"
                      Class="management-drop-container">
        <ChildContent>
            <div class="management-grid">
                @foreach (var character in Core.Content.Characters)
                {
                    <div class="guardian-column">
                        <span class="vault-location-label">@character.Value.Class</span>
                        @{
                            string equipped = character.Value.CharacterId + "Equipped";
                        }
                        <MudDropZone T="DItem" Identifier="@equipped"
                                     Class="drop-zone equipped-zone"></MudDropZone>
                        <MudDropZone T="DItem" Identifier="@character.Value.CharacterId"
                                     Class="drop-zone inventory-zone"></MudDropZone>
                    </div>
                }
                <div class="vault-column">
                    <span class="vault-location-label">Vault</span>
                    <MudDropZone T="DItem" Identifier="Vault"
                                 Class="drop-zone vault-zone"/>
                </div>
            </div>
        </ChildContent>
        <ItemRenderer>
            <ItemModel Item=@context />
        </ItemRenderer>
    </MudDropContainer>
</MudPaper>

@code {

    /// <summary>
    /// Render key that determines if the content in the management list needs to be refreshed
    /// </summary>
    private Guid RenderKey => Core.Content.ItemManagementRenderKey;

    /// <summary>
    /// The items to display in the management list
    /// </summary>
    [Parameter]
    public required IEnumerable<DItem> Items { get; set; }

    /// <summary>
    /// Gets called when the component first initializes.
    /// </summary>
    protected override void OnInitialized()
    {
        // Connects
        Core.Content.Transfer.TransferOccured += RefreshState;
    }
    
    /// <summary>
    /// Handles transfers of items between buckets and informs the core of the change.
    /// Supports Vault to Character, Character to Vault, and Character to Character transfers.
    /// </summary>
    /// <param name="item">Item being transferred.</param>
    private async Task Transfer(MudItemDropInfo<DItem> item)
    {
        if (item.Item == null || !Core.Content.Transfer.TransfersAllowed || !(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        DItem transfer = item.Item;

        // Item bucket Identification
        string origin = transfer.Identifier;
        string destination = item.DropzoneIdentifier;

        if (destination == origin)
        {
            return;
        }

        string transferBucket = destination;
        if (destination != "Vault")
        {
            transferBucket = Core.Content.Characters.FirstOrDefault(x => x.Value.CharacterId == destination.Replace("Equipped", string.Empty)).Value.Class ?? destination;
        }

        Core.Snackbar.AddMessage($"Transferring {transfer.Details.DisplayProperties.Name} to {transferBucket}.", "Info");

        string itemID = Core.Content.Transfer.QueueTransfer(TransferType.Push, transfer, destination);

        while (Core.Content.Transfer.GetTransferStatus(itemID) == 2)
        {
            await Task.Delay(100);
        }

        if (Core.Content.Transfer.GetTransferStatus(itemID) == 0)
        {
            Core.Snackbar.AddMessage($"Transfer of {transfer.Details.DisplayProperties.Name} to {transferBucket} was Successful.", "Success");
        }
    }

    /// <summary>
    /// Slot that responds to changes in the content manager and informs Blazor that a refresh is needed.
    /// </summary>
    private void RefreshState()
    {
        InvokeAsync(StateHasChanged);
    }
}
