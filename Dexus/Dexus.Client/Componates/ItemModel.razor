@using GuardianServices.Models
@using DexusCore
@using GuardianServices

@inject Core Core

<!-- Main Display -->
<MudCard
    Style="width: 80px; height: 80px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; position: relative;"
    Elevation="4" @onclick="() => TogglePopover(itemModelID)">
    @{ string iconPath = $"https://www.bungie.net{@Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Icon}"; }
    <MudCardMedia Image="@iconPath" alt="Weapon"
                  Style="width: 100%; height: 100%; object-fit: cover;"/>
    @if (Item.Power != 0)
    {
        <div
            style="position: absolute; top: 4px; right: 4px; background: rgba(0, 0, 0, 0.6); color: white; padding: 2px 6px; font-size: 12px; border-radius: 4px;">@Item.Power</div>
    }
    else if (@Item.Quantity != 1)
    {
        <div
            style="position: absolute; top: 4px; right: 4px; background: rgba(0, 0, 0, 0.6); color: white; padding: 2px 6px; font-size: 12px; border-radius: 4px;">@Item.Quantity.ToString()</div>
    }
</MudCard>

<!-- Popover for Info and Actions for the Item -->
@if (!string.IsNullOrEmpty(Item.ItemInstanceId))
{
    <MudPopover Open=@(activeItemID == itemModelID) AnchorOrigin="Origin.TopCenter"
                TransformOrigin="Origin.BottomCenter">
        <MudPaper Class="pa-3" 
                  Style="min-width: 300px; 
                     max-width: 350px; 
                     border-radius: 12px; 
                     box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3); 
                     backdrop-filter: blur(6px);
                     background: rgba(30, 30, 30, 0.9);
                     color: white;
                     animation: fadeIn 0.2s ease-out;">
                     
            <!-- Header with Name and Close Button -->
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <MudText Typo="Typo.h6" Style="flex-grow: 1; font-weight: 600;">@Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="()=>activeItemID = null"
                               Size="Size.Small" Style="color: white;" />
            </div>

            @if (Item.IsWeapon())
            {
                <!-- Slot Details Grid -->
                <div class="mt-2" 
                     style="display: grid; 
                        grid-template-columns: 1fr 3fr 1fr; 
                        gap: 6px; 
                        text-align: center;">
                        
                    <div class="slot-header">Archetype</div>
                    <div class="slot-header">Perks</div>
                    <div class="slot-header">Masterwork</div>

                    <!-- Archetype -->
                    <div class="slot-icon">
                        @{
                            string archIconPath = $"https://www.bungie.net{Item.Perks.FirstOrDefault(i => i.IsVisible)?.IconPath}";
                        }
                        <MudTooltip Text="Placeholder">
                            <img src="@archIconPath" class="perk-icon" />
                        </MudTooltip>
                    </div>

                    <!-- Perk Slots -->
                    <div style="display: flex; justify-content: center; gap: 6px;">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                                @if (Item.Sockets.Plugs.TryGetValue(i, out var plug))
                                {
                                    @foreach (var perk in plug)
                                    {
                                        string iconPath = $"https://www.bungie.net{Core.Content.PerkDetails[perk.PlugItemHash].DisplayProperties.Icon}";
                                        string altText = Core.Content.PerkDetails[perk.PlugItemHash].DisplayProperties.Name;
                                        <MudTooltip Text="@altText">
                                            <img src="@iconPath" class="perk-icon" />
                                        </MudTooltip>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <!-- Masterwork Placeholder -->
                    <div class="slot-icon">
                        Placeholder
                    </div>
                </div>

                <!-- Weapon Stats -->
                <MudExpansionPanel Text="Weapon Stats" MaxHeight="150">
                    <MudList T="string">
                        <MudListItem Text="Range" Icon="@Icons.Material.Filled.GpsFixed"/>
                        <MudListItem Text="Stability" Icon="@Icons.Material.Filled.ShowChart"/>
                        <MudListItem Text="Reload Speed" Icon="@Icons.Material.Filled.Sync"/>
                    </MudList>
                </MudExpansionPanel>
            }

            <!-- Transfer and Postmaster Actions -->
            <div class="mt-3" style="display: flex; justify-content: space-between; gap: 8px;">
                @if (Item.Bucket == "Lost Items")
                {
                    <MudButton Color="Color.Warning" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowDown"
                               OnClick="() => PullFromPostmaster()" 
                               Style="flex-grow: 1;">
                        Pull From Postmaster
                    </MudButton>
                }
                else
                {
                    <div class="transfer-options">
                        @foreach (Character character in Core.Content.Characters.Values.Where(c => c.CharacterId != Item.Identifier?.Replace("Equipped", string.Empty)))
                        {
                            string iconPath = $"/Resources/{character.Class}_Emblem.jpg";

                            <MudTooltip Text=@character.Class>
                                <MudIconButton Disabled="@processing" Tag=@character.CharacterId
                                               OnClick="() => Transfer(character.CharacterId ?? string.Empty)"
                                               Variant="Variant.Filled" Color="Color.Dark"
                                               Style="width: 48px; height: 48px; padding: 0; display: flex; justify-content: center; align-items: center; overflow: hidden;">
                                    <img src="@iconPath" class="transfer-icon" />
                                </MudIconButton>

                            </MudTooltip>
                        }

                        @if (Item.Identifier != "Vault")
                        {
                            string vault = "Vault";
                            <MudTooltip Text="Vault">
                                <MudIconButton Disabled="@processing" Tag="@vault"
                                               OnClick="() => Transfer(vault)"
                                               Variant="Variant.Filled" Color="Color.Dark"
                                               Style="width: 48px; height: 48px; overflow: hidden; padding: 0;">
                                    <img src="/Resources/VaultEmblem.png" class="transfer-icon" />
                                </MudIconButton>
                            </MudTooltip>
                        }
                    </div>
                }
            </div>
        </MudPaper>
    </MudPopover>
    
    <style>
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .slot-header {
            font-weight: 600;
            background: rgba(255, 255, 255, 0.1);
            padding: 6px;
            border-radius: 4px;
        }

        .slot-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 6px;
        }

        .perk-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            transition: transform 0.2s;
        }

        .perk-icon:hover {
            transform: scale(1.1);
        }

        .transfer-options {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .transfer-icon {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            transition: transform 0.2s;
        }

        .transfer-icon:hover {
            transform: scale(1.1);
        }
    </style>
}

@code {

    /// <summary>
    /// The Item to be represented by this model.
    /// </summary>
    [Parameter]
    public required Item Item { get; set; }

    // Property Popover locks
    private static Guid? activeItemID = null;
    private Guid itemModelID = Guid.NewGuid();

    // Item variables
    bool processing = false;

    private void TogglePopover(Guid itemId)
    {
        if (activeItemID == itemId)
        {
            activeItemID = null; // TODO: Clicking the same item closes it, at least it is supposed to but it aint working
        }
        else
        {
            activeItemID = itemId; // TODO: Clicking a different item switches the popover, at least it is supposed to but it aint working
        }
    }

    /// <summary>
    /// Transfers the item being represented to the destination provided.
    /// </summary>
    /// <param name="destination">Location to transfer the item to.</param>
    private async Task Transfer(string destination)
    {
        if (!(await Core.ConfirmOAuthStatus()) || !Core.Content.TransfersAllowed)
        {
            return;
        }

        string origin = Item.Identifier ?? string.Empty;

        string characterName = Core.Content.Characters.FirstOrDefault(x => x.Value.CharacterId == destination).Value.Class ?? destination;
        Core.Snackbar.AddMessage($"Transferring {Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name} to {characterName}.", "Info");

        string itemID = Core.Content.QueueTransfer(Item, origin, destination);

        while (Core.Content.GetTransferStatus(itemID) == 2)
        {
            await Task.Delay(100);
        }

        if (Core.Content.GetTransferStatus(itemID) == 0)
        {
            Core.Snackbar.AddMessage($"Transfer of {Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name} to {characterName} was Successful.", "Success");
        }

        this.StateHasChanged();
    }

    /// <summary>
    /// Pulls the item from postmaster.
    /// </summary>
    private async Task PullFromPostmaster()
    {
        if (!(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        Core.Snackbar.AddMessage($"Pulling {Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name} from Postmaster.", "Info");

        if (await Core.Content.PullFromPostmaster(this.Item))
        {
            Core.Snackbar.AddMessage($"Successfully pulled {Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name} from Postmaster.", "Success");
        }
    }

    /// <summary>
    /// Selects the perk oon the item.
    /// </summary>
    private async Task SelectPerk()
    {
        if (!(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        // TODO: Add functionality to change an items perk in Content Manager.
        return;
    }

}