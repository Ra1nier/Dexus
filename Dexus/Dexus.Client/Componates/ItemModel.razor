@using Dexus.Client.Componates.InfoPopovers
@using GuardianServices.Models
@using DexusCore
@using GuardianServices

@inject Core Core

@{
    string cardSize = $"max(40px, calc(min({Size}px, var(--vault-base-item-size, {Size}px)) * var(--vault-icon-scale, 1)))";
    string sizeStyle = $"width: {cardSize}; height: {cardSize};";
    string borderStyle = string.Empty;
    bool hasDisplayData = Item?.Details?.DisplayProperties != null;
    string iconPath = hasDisplayData ? $"https://www.bungie.net{Item!.Details.DisplayProperties.Icon}" : string.Empty;
}

<!-- Main Display -->
<MudCard class="item-card"
         Style="@($"{sizeStyle} position: relative;")"
         @onclick="TogglePopover">

    @if (!hasDisplayData)
    {
        <div class="missing-item">?</div>
    }
    else if (Item!.IsCrafted())
    {
        <div class="crafted-gradient-overlay"></div>
    }
    
    @if (hasDisplayData && Item!.IsMasterworked())
    {
        <div class="masterworked-gradient-overlay"></div>
    }

    @if (hasDisplayData)
    {
        <MudCardMedia Image="@iconPath" alt="Item"
                      Style="width: 100%; height: 100%; object-fit: cover;" />
    }

    @if (hasDisplayData && Item!.Power != 0)
    {
        <div class="power-label">@Item.Power</div>
    }
    else if (hasDisplayData && Item!.Quantity != 1)
    {
        <div class="power-label">@Item.Quantity</div>
    }
</MudCard>


<!-- Popover for Info and Actions for the Item -->
@if (hasDisplayData)
{
    <ItemPopover Item="@Item" Condition="@Condition" />
}

@code {
    /// <summary>
    /// The Item to be represented by this model.
    /// </summary>
    [Parameter]
    public required DItem Item { get; set; }

    /// <summary>
    /// Optional size in pixels for the card (width and height).
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 80;

    // Condition to control popover visibility
    private bool Condition { get; set; } = false;

    private void TogglePopover()
    {
        Condition = !Condition;
    }
}

<style>
    .item-card {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
        cursor: pointer;
        overflow: hidden;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .item-card:hover {
        border-color: rgba(255, 255, 255, 0.34);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.34);
        transform: translateY(-1px);
    }

    .missing-item {
        align-items: center;
        background: #303030;
        color: #d0d0d0;
        display: flex;
        font-size: 24px;
        height: 100%;
        justify-content: center;
        width: 100%;
    }

    .crafted-gradient-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 33%;
        background: linear-gradient(to top, rgba(229, 57, 53, 0.56), transparent);
        pointer-events: none;
        z-index: 2;
    }
    
    .masterworked-gradient-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 33%;
        background: linear-gradient(to top, rgba(255, 193, 7, 0.72), transparent);
        pointer-events: none;
        z-index: 2;
    }

    /* Power/quantity label */
    .power-label {
        position: absolute;
        top: 4px;
        right: 4px;
        background: rgba(0, 0, 0, 0.64);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 4px;
        color: white;
        font-weight: 700;
        padding: 2px 6px;
        font-size: 12px;
        z-index: 3;
    }
</style>
