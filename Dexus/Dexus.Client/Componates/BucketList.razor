@using GuardianServices.Models
@using DexusCore

@inject Core Core

@if (Sorted)
{
    <MudPaper Class="bucket-shelf" @key="RenderKey">
        <MudGrid Class="bucket-grid" Justify="Justify.SpaceBetween">
            @foreach (var character in Core.Content.Characters.Values)
            {
                <MudItem xs="12" sm="6" md="3" lg="2" Class="bucket-column">
                    <MudDropZone T="Item" Identifier=@character.CharacterId
                                 Class="bucket-drop-zone">
                        @foreach (var item in Items.Where(i => i.Identifier == character.CharacterId))
                        {
                            <ItemModel Item=@item Size="60" />
                        }
                    </MudDropZone>
                </MudItem>
            }

            <MudItem xs="12" sm="12" md="6" lg="6" Class="bucket-column">
                @if ((Items.Count(x => x.Identifier == "Vault")) > 0)
                {
                    <MudDropZone T="Item" Identifier="Vault"
                                 Class="bucket-drop-zone bucket-vault-zone"/>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
}
else
{
    <MudPaper Class="bucket-shelf" @key="RenderKey">
        <MudGrid Class="bucket-grid bucket-grid-padded" Justify="Justify.SpaceBetween">
            <MudDropZone T="Item"
                         Class="bucket-drop-zone bucket-wide-zone">
                @foreach (var item in Items)
                {
                    <MudItem Class="d-flex flex-column">
                        <ItemModel Item=@item />
                    </MudItem>
                }
            </MudDropZone>
        </MudGrid>
    </MudPaper>
}

@code {

    /// <summary>
    /// Render key that determines if the content in the bucket list needs to be refreshed.
    /// </summary>
    private Guid RenderKey => Core.Content.ItemManagementRenderKey;

    /// <summary>
    /// Items to display in the bucket list.
    /// </summary>
    [Parameter]
    public required IEnumerable<DItem> Items { get; set; }

    /// <summary>
    /// A bool value used to determine if the items should be sorted by character.
    /// </summary>
    [Parameter]
    public required bool Sorted { get; set; }
    
    /// <summary>
    /// Gets called when the component first initializes.
    /// </summary>
    protected override void OnInitialized()
    {
        // Connects
        Core.Content.Transfer.TransferOccured += RefreshState;
    }
    
    /// <summary>
    /// Slot that responds to changes in the content manager and informs Blazor that a refresh is needed.
    /// </summary>
    private void RefreshState()
    {
        InvokeAsync(StateHasChanged);
    }
}

<style>
    .bucket-shelf {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 12px;
    }

    .bucket-grid {
        width: 100%;
    }

    .bucket-grid-padded {
        padding: 8px;
    }

    .bucket-column {
        display: flex;
        flex-direction: column;
        padding: 8px;
    }

    .bucket-drop-zone {
        align-content: flex-start;
        background: rgba(255, 255, 255, 0.045);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-height: 96px;
        padding: 10px;
        width: 100%;
    }

    .bucket-vault-zone,
    .bucket-wide-zone {
        min-height: 132px;
    }
</style>
