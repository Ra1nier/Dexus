@using GuardianServices.Models
@using DexusCore

@inject Core Core

@if (Sorted)
{
    <MudPaper Class="d-flex flex-column gap-2" @key="RenderKey">
        <MudGrid Class="d-flex" Justify="Justify.SpaceBetween">
            @foreach (var character in Core.Content.Characters.Values)
            {
                <MudItem xs="6" sm="3" md="2" lg="2" Class="d-flex flex-column">
                    <MudDropZone T="Item" Identifier=@character.CharacterId
                                 Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1"
                                 Style="height: 100%; width: 100%;">
                        @foreach (var item in Items.Where(i => i.Identifier == character.CharacterId))
                        {
                            <ItemModel Item=@item />
                        }
                    </MudDropZone>
                </MudItem>
            }

            <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column">
                @if ((Items.Count(x => x.Identifier == "Vault")) > 0)
                {
                    <MudDropZone T="Item" Identifier="Vault"
                                 Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1"
                                 Style="min-width: 50%; height: 100%;"/>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
}
else
{
    <MudPaper Class="d-flex flex-column gap-2" @key="RenderKey">
        <MudGrid Class="d-flex flex-wrap gap-2" Justify="Justify.SpaceBetween" Style="padding: 25px">
            <MudDropZone T="Item"
                         Class="rounded mud-background-gray pa-4 ma-4 d-flex flex-wrap gap-1"
                         Style="height: 100%; width: 100%;">
                @foreach (var item in Items)
                {
                    <MudItem Class="d-flex flex-column">
                        <ItemModel Item=@item />
                    </MudItem>
                }
            </MudDropZone>
        </MudGrid>
    </MudPaper>
}

@code {

    /// <summary>
    /// Render key that determines if the content in the bucket list needs to be refreshed.
    /// </summary>
    private Guid RenderKey => Core.Content.ItemManagementRenderKey;

    /// <summary>
    /// Items to display in the bucket list.
    /// </summary>
    [Parameter]
    public required IEnumerable<DItem> Items { get; set; }

    /// <summary>
    /// A bool value used to determine if the items should be sorted by character.
    /// </summary>
    [Parameter]
    public required bool Sorted { get; set; }
    
    /// <summary>
    /// Gets called when the component first initializes.
    /// </summary>
    protected override void OnInitialized()
    {
        // Connects
        Core.Content.TransferOccured += RefreshState;
    }
    
    /// <summary>
    /// Slot that responds to changes in the content manager and informs Blazor that a refresh is needed.
    /// </summary>
    private void RefreshState()
    {
        InvokeAsync(StateHasChanged);
    }
}
