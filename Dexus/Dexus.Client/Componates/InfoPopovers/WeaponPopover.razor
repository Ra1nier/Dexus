@using GuardianServices.Models
@using DexusCore

@inject Core Core

<!-- Slot Details Grid -->
<div class="mt-2"
     style="display: grid; 
                        grid-template-columns: 1fr 3fr 1fr; 
                        gap: 6px; 
                        text-align: center;">

    <div class="slot-header">Archetype</div>
    <div class="slot-header">Perks</div>
    <div class="slot-header">Origin</div>

    <!-- Archetype -->
    <div class="slot-icon">
        <MudTooltip Text="Placeholder">
            <!-- <img src="@archIconPath" class="perk-icon"/> -->
        </MudTooltip>
    </div>

    <!-- Perk Slots -->
    @if (Item.Plugs != null)
    {
        <!-- Traits -->
        <div style="display: flex; justify-content: center; gap: 6px;">
            @foreach (var plugSlot in Item.Plugs.ReusablePlugs.Values)
            {
                <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                    @foreach (var reusablePlug in plugSlot.Where(i => i.IsMainPlug()))
                    {
                        string iconPath = $"https://www.bungie.net{reusablePlug.Details.DisplayProperties.Icon}";
                        string altText = reusablePlug.Details.DisplayProperties.Name;
                        <MudTooltip Text="@altText">
                            <div class="icon-container">
                                <img src="@iconPath" class="perk-icon base-icon"/>
                                @if (reusablePlug.IsEnhanced())
                                {
                                    <img src="/Resources/enhancedOverlay.png" class="perk-icon overlay-icon"/>
                                }
                            </div>
                        </MudTooltip>
                    }
                </div>
            }
        </div>

        <!-- Origin(s) -->
        <div class="slot-icon">
            Placeholder
        </div>
    }
</div>

<!-- Weapon Stats -->
<MudExpansionPanel Text="Weapon Stats" MaxHeight="150">
    <MudList T="string">
        <MudListItem Text="Range" Icon="@Icons.Material.Filled.GpsFixed"/>
        <MudListItem Text="Stability" Icon="@Icons.Material.Filled.ShowChart"/>
        <MudListItem Text="Reload Speed" Icon="@Icons.Material.Filled.Sync"/>
    </MudList>
</MudExpansionPanel>

@code {

    /// <summary>
    /// Item to display Info About.
    /// </summary>
    [Parameter]
    public required DItem Item { get; set; }

    /// <summary>
    /// Selects the perk oon the item.
    /// </summary>
    private async Task SelectPerk()
    {
        if (!await Core.ConfirmOAuthStatus())
        {
            return;
        }

        // TODO: Add functionality to change an items perk in Content Manager.
        return;
    }

}

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .slot-header {
        font-weight: 600;
        background: rgba(255, 255, 255, 0.1);
        padding: 6px;
        border-radius: 4px;
    }

    .slot-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 6px;
    }

    .perk-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        transition: transform 0.2s;
    }

    .perk-icon:hover {
        transform: scale(1.1);
    }

    .icon-container {
        position: relative;
        width: 32px;
        height: 32px;
    }

    .base-icon {
        position: relative;
        z-index: 1;
    }

    .overlay-icon {
        position: absolute;
        top: 0;
        left: -10px;
        z-index: 2;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        pointer-events: none;
    }

    .transfer-options {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .transfer-icon {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.2s;
    }

    .transfer-icon:hover {
        transform: scale(1.1);
    }
</style>