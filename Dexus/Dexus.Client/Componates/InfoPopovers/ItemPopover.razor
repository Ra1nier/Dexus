@using System.Text.Json
@using GuardianServices.Models
@using DexusCore

@inject Core Core

<MudPopover Open=@Condition AnchorOrigin="Origin.TopCenter"
            TransformOrigin="Origin.BottomCenter">
    <MudPaper Class="pa-3"
              Style="min-width: 300px; 
                     max-width: 350px; 
                     border-radius: 12px; 
                     box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3); 
                     backdrop-filter: blur(6px);
                     background: rgba(30, 30, 30, 0.9);
                     color: white;
                     animation: fadeIn 0.2s ease-out;">

        <!-- Header with Name and Close Button -->
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <MudText Typo="Typo.h6"
                     Style="flex-grow: 1; font-weight: 600;">@Item.Details.DisplayProperties.Name</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="() => Condition = false"
                           Size="Size.Small" Style="color: white;"/>
        </div>

        <!-- Additional Item Info Panel -->
        @if (Item.IsWeapon())
        {
            <WeaponPopover Item="@Item" />
        }
        else if (Item.IsArmor())
        {
            <ArmorPopover Item="@Item" />
        }

        @if (!string.IsNullOrEmpty(Item.ItemInstanceId))
        {
            if (Item.Bucket == "Lost Items")
            {
                <div class="transfer-layout">
                    <MudButton Color="Color.Warning" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowDown"
                               OnClick="() => PullFromPostmaster()"
                               class="postmaster-button">
                        Pull From Postmaster
                    </MudButton>
                </div>
            }
            else
            {
                <div class="transfer-layout">
                    <div class="transfer-label-row">
                        <span>Transfer</span>
                        <span>Equip</span>
                    </div>

                    <div class="transfer-button-row">
                        <!-- Transfer Buttons -->
                        <div class="transfer-group">
                            @foreach (var character in Core.Content.Characters.Values
                                              .Where(c => c.CharacterId != Item.Identifier?.Replace("Equipped", string.Empty)))
                            {
                                string iconPath = $"/Resources/{character.Class}_Emblem.svg";
                                string toolText = $"Transfer to {character.Class}";

                                <MudTooltip Text="@toolText">
                                    <MudIconButton Disabled="@processing" Tag="@character.CharacterId"
                                                   OnClick="() => Transfer(character.CharacterId ?? string.Empty)"
                                                   Variant="Variant.Filled" Color="Color.Default"
                                                   class="transfer-icon-button">
                                        <img src="@iconPath" alt="@character.Class" class="transfer-icon"/>
                                    </MudIconButton>
                                </MudTooltip>
                            }

                            @if (Item.Identifier != "Vault")
                            {
                                string vault = "Vault";
                                <MudTooltip Text="Transfer to Vault">
                                    <MudIconButton Disabled="@processing" Tag="vault"
                                                   OnClick="() => Transfer(vault)"
                                    Variant="Variant.Filled" Color="Color.Default"
                                    class="transfer-icon-button">
                                    <img src="/Resources/VaultEmblem.png" alt="Vault" class="transfer-icon"/>
                                    </MudIconButton>
                                </MudTooltip>
                            }
                        </div>

                        <!-- Equip Buttons -->
                        <div class="transfer-group">
                            @foreach (var character in Core.Content.Characters.Values)
                            {
                                string iconPath = $"/Resources/{character.Class}_Emblem.svg";
                                string destination = $"{character.CharacterId}Equipped";
                                string toolText = $"Equip on {character.Class}";

                                <MudTooltip Text="@toolText">
                                    <MudIconButton Disabled="@processing" Tag="@character.CharacterId"
                                                   OnClick="() => Transfer(destination)"
                                                   Variant="Variant.Filled" Color="Color.Default"
                                                   class="transfer-icon-button">
                                        <img src="@iconPath" alt="@character.Class" class="transfer-icon"/>
                                    </MudIconButton>
                                </MudTooltip>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        
        <!-- Debug REMOVE -->
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowDown"
                   OnClick="() => CreateJSON()"
                   class="postmaster-button">
            Create Item JSON
        </MudButton>
    </MudPaper>
</MudPopover>

@code {

    /// <summary>
    /// Item to display Info About.
    /// </summary>
    [Parameter]
    public required DItem Item { get; set; }

    /// <summary>
    /// Bool liked to whether the popover should be displayed.
    /// </summary>
    [Parameter]
    public required bool Condition { get; set; }

    /// <summary>
    /// Derived component HTML content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Indicates whether an action is currently being processed for the item. 
    /// </summary>
    protected bool processing = false;

    /// <summary>
    /// Gets called when the component first initializes.
    /// </summary>
    protected override void OnInitialized()
    {
        // Connects
        // Core.Content.TransferOccured += RefreshState; Probably not needed.
    }

    /// <summary>
    /// Transfers the item being represented to the destination provided.
    /// </summary>
    /// <param name="destination">Location to transfer the item to.</param>
    protected async Task Transfer(string destination)
    {
        if (!(await Core.ConfirmOAuthStatus()) || !Core.Content.Transfer.TransfersAllowed)
        {
            return;
        }

        string origin = Item.Identifier;

        string characterName = destination;
        if (destination != "Vault")
        {
            characterName = Core.Content.Characters.FirstOrDefault(x => x.Value.CharacterId == destination).Value.Class ?? destination;
        }

        Core.Snackbar.AddMessage($"Transferring {Item.Details.DisplayProperties.Name} to {characterName}.", "Info");

        string itemID = Core.Content.Transfer.QueueTransfer(TransferType.Push, Item, destination);

        while (Core.Content.Transfer.GetTransferStatus(itemID) == 2)
        {
            await Task.Delay(100);
        }

        if (Core.Content.Transfer.GetTransferStatus(itemID) == 0)
        {
            Core.Snackbar.AddMessage($"Transfer of {Item.Details.DisplayProperties.Name} to {characterName} was Successful.", "Success");
        }
    }

    /// <summary>
    /// Pulls the item from postmaster.
    /// </summary>
    protected async Task PullFromPostmaster()
    {
        if (!(await Core.ConfirmOAuthStatus()))
        {
            return;
        }

        // Core.Snackbar.AddMessage($"Pulling {Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name} from Postmaster.", "Info");
        Core.Snackbar.AddMessage($"Currently pulling items from the postmaster is not available.", "Warning");

        /*if (await Core.Content.PullFromPostmaster(this.Item)) TODO: This needs to be redone.
        {
            Core.Snackbar.AddMessage($"Successfully pulled {Core.Content.ItemDetails[Item.ItemHash].DisplayProperties.Name} from Postmaster.", "Success");
        }*/
    }

    /// <summary>
    /// TODO: Only used for Debug -- Needs to be removed.
    /// Creates a JSON file containing the Serialized DItem for the ItemModel.
    /// </summary>
    private void CreateJSON()
    {
        string savePath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "JSON", $"{Item.Details.DisplayProperties.Name}-DItem.json");
        string itemJSON = JsonSerializer.Serialize<DItem>(Item);
        File.WriteAllText(savePath, itemJSON);
        Core.Snackbar.AddMessage($"Item JSON Created to {savePath}");
    }

    /// <summary>
    /// Slot that responds to changes in the content manager and informs Blazor that a refresh is needed.
    /// </summary>
    private void RefreshState()
    {
        InvokeAsync(StateHasChanged);
    }

}

<style>
    .transfer-layout {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
    }

    .transfer-label-row {
        display: flex;
        justify-content: space-around;
        width: 100%;
        max-width: 400px;
        font-weight: bold;
        font-size: 0.95rem;
    }

    .transfer-button-row {
        display: flex;
        justify-content: space-around;
        width: 100%;
        max-width: 400px;
        gap: 20px;
    }

    .transfer-group {
        display: flex;
        gap: 6px;
        flex-wrap: nowrap;
    }

    .transfer-icon-button {
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: 8px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .transfer-icon {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.2s;
    }

    .transfer-icon:hover {
        transform: scale(1.1);
    }

    .postmaster-button {
        height: 40px;
        white-space: nowrap;
    }
</style>