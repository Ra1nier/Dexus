@using DexusCore
@using UIServices
@using Flairs.DialogBoxes

@inherits LayoutComponentBase

@inject Core Core
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> Logger
@inject IDialogService DialogService
@inject DialogUIService DialogUIService

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout>
    <MudAppBar Elevation="1">
        <!-- Left Side of app bar -->
        <NavMenu />
        
        <MudSpacer/>
        
        <!-- Right side of app bar -->
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle"/>
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Edge="Edge.End"
                       OnClick="@AccountDrawerToggle"/>
    </MudAppBar>

    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _accountDrawerOpen = false;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;

    /// <summary>
    /// Starts the process when the webpage is loaded.
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };

        StartSnackbarProvider();
        StartDialogService();
    }
    
    /// <summary>
    /// Starts the snackbar provider to display messages to the user.
    /// </summary>
    private void StartSnackbarProvider()
    {
        new Thread(async void () =>
        {
            try
            {
                while (true)
                {
                    await Task.Delay(1000);
                    while (Core.Snackbar.NextMessage(out string message, out string severity, out Action<SnackbarOptions> config))
                    {
                        Severity mode = (Severity)Enum.Parse(typeof(Severity), severity);
                        Snackbar.Add(message, mode, config);
                    }
                }
            }
            catch (Exception e)
            {
                Logger.LogError($"An unknown error occured when executing the Snackbar Task that has shutdown the task down: {e.Message}");
            }
        }).Start();
    }

    /// <summary>
    /// Starts the Dialog service to show Dialog Boxes to the user.
    /// </summary>
    private void StartDialogService()
    {
        new Thread(async void () =>
        {
            try
            {
                while (true)
                {
                    await Task.Delay(1000);
                    while (DialogUIService.NextDialog(out string title, out string message, out var action, out int type))
                    {
                        switch (type)
                        {
                            case 0:
                                await OpenMessageDialog(title, message);
                                break;
                            case 1:
                                await OpenConfirmationDialog(title, message, action);
                                break;
                        }
                    }
                }
            }
            catch (Exception e)
            {
                Logger.LogError($"An unknown error occured when executing the Dialog Task that has shutdown the task down: {e.Message}");
            }
        }).Start();
    }
    
    /// <summary>
    /// Opens a confirmation dialog with the given title and message. If the user accepts the dialog, the given action will be invoked.
    /// </summary>DialogService
    /// <param name="title">Title of the dialog.</param>
    /// <param name="message">Message body.</param>
    /// <param name="action">A Lambda/Action that should be invoked.</param>
    /// <returns>A Task representing the dialog.</returns>
    private async Task OpenConfirmationDialog(string title, string message, Action action)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmationDialog.Title), title },
            { nameof(ConfirmationDialog.Message), message }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            action.Invoke();
        }
    }

    /// <summary>
    /// Opens a message dialog with the given title and message.
    /// </summary>
    /// <param name="title">Title of the dialog.</param>
    /// <param name="message">Message body.</param>
    /// <returns>A Task representing the dialog.</returns>
    private Task OpenMessageDialog(string title, string message)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var parameters = new DialogParameters
        {
            { nameof(MessageDialog.Title), title },
            { nameof(MessageDialog.Message), message }
        };

        return DialogService.ShowAsync<MessageDialog>(title, parameters, options);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void AccountDrawerToggle()
    {
        _accountDrawerOpen = !_accountDrawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#4C9EEB",
        Surface = "#1A1A1A", // Deep dark gray instead of navy
        Background = "#181818", // Softer dark gray instead of pure black
        BackgroundGray = "#1E1E1E",
        AppbarText = "#E0E0E0",
        AppbarBackground = "rgba(26, 26, 26, 0.8)",
        DrawerBackground = "#181818",
        ActionDefault = "#A0A0B0",
        ActionDisabled = "#555555",
        ActionDisabledBackground = "#333333",
        TextPrimary = "#E0E0E0",
        TextSecondary = "#A0A0B0",
        TextDisabled = "#555555",
        DrawerIcon = "#E0E0E0",
        DrawerText = "#E0E0E0",
        GrayLight = "#262626",
        GrayLighter = "#303030",
        Info = "#4a86ff",
        Success = "#00BFA6",
        Warning = "#FFB545",
        Error = "#FF3F5F",
        LinesDefault = "#252525",
        TableLines = "#252525",
        Divider = "#252525",
        OverlayLight = "#18181880",
    };

    /// <summary>
    /// Holds the styles to use for dark mode.
    /// </summary>
    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };

}