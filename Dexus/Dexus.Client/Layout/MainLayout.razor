@using Dexus.Client.Pages
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudDialogProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <!-- Left Side of app bar -->
        <NavMenu />
        
        <MudSpacer/>
        
        <!-- Right side of app bar -->
        @if (refreshingContent)
        {
            <MudProgressCircular Size="Size.Medium" Indeterminate="true"/>
        }
        else
        {
            <MudTooltip Text="@tooltipText">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit"
                               OnClick="@RefreshClientContent"/>
            </MudTooltip>
        }
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle"/>
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Edge="Edge.End"
                       OnClick="@AccountDrawerToggle"/>
    </MudAppBar>

    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>



<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _accountDrawerOpen = false;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;

    // Custom variables
    private bool refreshingContent = false;
    private DateTime lastRefreshTime = DateTime.Now;
    private string tooltipText = "Time Since Last Refresh: 00:00";
    private System.Timers.Timer? refreshUpdateTimer;

    /// <summary>
    /// Starts the process when the webpage is loaded.
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
        
        refreshUpdateTimer = new System.Timers.Timer(1000);
        refreshUpdateTimer.Elapsed += (sender, e) => UpdateTooltip();
        refreshUpdateTimer.AutoReset = true;
        refreshUpdateTimer.Enabled = true;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void AccountDrawerToggle()
    {
        _accountDrawerOpen = !_accountDrawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private async Task RefreshClientContent()
    {
        refreshingContent = true;
        StateHasChanged();

        await DexusVaultManager.Content.RefreshUserContent();

        lastRefreshTime = DateTime.Now;
        refreshingContent = false;
        StateHasChanged();
    }

    private void UpdateTooltip()
    {
        TimeSpan elapsed = DateTime.Now - lastRefreshTime;
        tooltipText = $"Time Since Last Refresh: {elapsed:mm\\:ss}";
        InvokeAsync(StateHasChanged);
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#4C9EEB",
        Surface = "#1A1A1A", // Deep dark gray instead of navy
        Background = "#181818", // Softer dark gray instead of pure black
        BackgroundGray = "#1E1E1E",
        AppbarText = "#E0E0E0",
        AppbarBackground = "rgba(26, 26, 26, 0.8)",
        DrawerBackground = "#181818",
        ActionDefault = "#A0A0B0",
        ActionDisabled = "#555555",
        ActionDisabledBackground = "#333333",
        TextPrimary = "#E0E0E0",
        TextSecondary = "#A0A0B0",
        TextDisabled = "#555555",
        DrawerIcon = "#E0E0E0",
        DrawerText = "#E0E0E0",
        GrayLight = "#262626",
        GrayLighter = "#303030",
        Info = "#4a86ff",
        Success = "#00BFA6",
        Warning = "#FFB545",
        Error = "#FF3F5F",
        LinesDefault = "#252525",
        TableLines = "#252525",
        Divider = "#252525",
        OverlayLight = "#18181880",
    };

    /// <summary>
    /// Holds the styles to use for dark mode.
    /// </summary>
    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };

}